<%- include('partials/head') %>
<%- include('partials/navbar') %>

<style>
    /* Dot paper background for hand-drawn sketch look */
    .sketch-bg {
        background-color: #fbf9f6;
        background-image: radial-gradient(#e5ddd0 1.5px, transparent 1.5px), radial-gradient(#e5ddd0 1.5px, #fbf9f6 1.5px);
        background-size: 30px 30px;
        background-position: 0 0, 15px 15px;
    }

    /* Hand-drawn style polaroid cards */
    .polaroid-card {
        border: 2px solid #2d2620;
        box-shadow: 5px 5px 0px #2d2620;
        border-radius: 4px;
        background: #ffffff;
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease;
    }
    
    .polaroid-card:hover {
        transform: scale(1.05) rotate(0deg) !important;
        box-shadow: 8px 8px 0px #e5792a;
        z-index: 10;
    }

    /* Sketchy lines animation */
    .branch-line {
        stroke: #2d2620; /* Charcoal color */
        stroke-width: 3.5;
        stroke-dasharray: 1200;
        stroke-dashoffset: 1200;
        animation: grow-root 2s ease-out forwards;
    }

    @keyframes grow-root {
        to {
            stroke-dashoffset: 0;
        }
    }
</style>

<main class="sketch-bg pt-32 pb-24 min-h-screen relative overflow-hidden">
    <!-- SVG Canvas behind the cards -->
    <svg id="rootCanvas" class="absolute inset-0 w-full h-full pointer-events-none z-0" style="min-height: 100%;">
        <!-- Lines will be dynamically generated by JS -->
    </svg>

    <div class="max-w-7xl mx-auto px-4 relative z-10">
        <!-- Header -->
        <div class="text-center mb-16">
            <span class="inline-block px-4 py-1 bg-karang-100 text-karang-700 rounded-full text-xs font-bold mb-4 filter drop-shadow-sm">
                Masa Bakti Resmi
            </span>
            <h2 class="text-4xl md:text-5xl font-black text-gray-900 tracking-tight" style="font-family: 'Poppins', sans-serif;">
                Struktur Kepengurusan
            </h2>
            <p class="text-gray-600 mt-3 max-w-xl mx-auto text-sm md:text-base">
                Akar pergerakan dan kolaborasi pemuda Karang Taruna Kelurahan Tanjung dalam memajukan masyarakat.
            </p>
        </div>

        <% if (pengurus.length === 0) { %>
            <div class="text-center py-20 bg-white border-2 border-gray-800 rounded-lg max-w-md mx-auto shadow-md">
                <i class="fas fa-sitemap text-gray-400 text-5xl mb-4"></i>
                <h3 class="text-lg font-bold text-gray-700">Struktur Belum Diisi</h3>
                <p class="text-gray-500 text-sm mt-1">Administrator belum mengisi data struktur organisasi.</p>
                <a href="/admin/pengurus" class="inline-block mt-6 px-6 py-2 bg-karang-500 text-white rounded-full text-sm font-semibold hover:bg-karang-600 transition">
                    Masuk Panel Admin
                </a>
            </div>
        <% } else { %>
            <%
            const bph = pengurus.filter(p => p.divisi === 'BPH');
            const divisiNames = {
                'Keagamaan': 'Kerohanian & Keagamaan',
                'Olahraga': 'Olahraga & Rekreasi',
                'Humas': 'Humas & Kemitraan',
                'Lingkungan': 'Kebersihan & Lingkungan',
                'Seni': 'Seni & Budaya'
            };
            const divisipengurus = {};
            Object.keys(divisiNames).forEach(div => {
                divisipengurus[div] = pengurus.filter(p => p.divisi === div);
            });
            %>

            <!-- BPH TIER -->
            <div class="flex flex-col items-center mb-24 relative" id="tier-bph">
                <!-- Ketua -->
                <% const ketua = bph[0]; // BPH list is pre-sorted by urutan, so first is Ketua %>
                <% if (ketua) { %>
                    <div class="mb-16 flex justify-center" id="card-member-<%= ketua.id %>">
                        <%- include('partials/member-card', { member: ketua, type: 'leader' }) %>
                    </div>
                <% } %>

                <!-- Wakil, Sekretaris, Bendahara, dll -->
                <% const otherBph = bph.slice(1); %>
                <% if (otherBph.length > 0) { %>
                    <div class="flex flex-wrap justify-center gap-12 md:gap-20 max-w-4xl" id="bph-subs">
                        <% otherBph.forEach(p => { %>
                            <div id="card-member-<%= p.id %>">
                                <%- include('partials/member-card', { member: p, type: 'bph' }) %>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>

            <!-- DIVISI / BIDANG TIER -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-12 items-start" id="tier-divisions">
                <% Object.entries(divisipengurus).forEach(([divKey, divMembers]) => { %>
                    <% if (divMembers.length > 0) { %>
                        <div class="flex flex-col items-center bg-white/40 backdrop-blur-sm border-2 border-gray-800 rounded-lg p-6 relative shadow-sm" id="division-col-<%= divKey %>">
                            <h3 class="text-xs font-black text-gray-800 border-b-2 border-orange-500 pb-2 mb-8 tracking-wider text-center uppercase" style="font-family: 'Poppins', sans-serif;">
                                <%= divisiNames[divKey] %>
                            </h3>
                            
                            <div class="flex flex-col gap-10 w-full items-center">
                                <% divMembers.forEach(p => { %>
                                    <div id="card-member-<%= p.id %>" class="w-full flex justify-center">
                                        <%- include('partials/member-card', { member: p, type: 'staff' }) %>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>
                <% }) %>
            </div>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const canvas = document.getElementById('rootCanvas');
        if (!canvas) return;

        // Apply random rotations to Polaroid cards for realistic sketchy look
        const cards = document.querySelectorAll('.polaroid-card');
        cards.forEach((card, index) => {
            // Apply slight random angles between -2.5 and +2.5 degrees
            const angle = (Math.random() * 5 - 2.5).toFixed(1);
            card.style.transform = `rotate(${angle}deg)`;
        });

        function redrawLines() {
            canvas.innerHTML = ''; // Clear previous paths
            
            // Re-inject the sketchy turbulence displacement filter
            const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
            defs.innerHTML = `
                <filter id="sketch-filter">
                    <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="3" result="noise" />
                    <feDisplacementMap in="SourceGraphic" in2="noise" scale="3" xChannelSelector="R" yChannelSelector="G" />
                </filter>
            `;
            canvas.appendChild(defs);

            const parentRect = document.querySelector('main').getBoundingClientRect();

            function getCenterTop(el) {
                const rect = el.getBoundingClientRect();
                return {
                    x: rect.left + rect.width / 2 - parentRect.left,
                    y: rect.top - parentRect.top
                };
            }

            function getCenterBottom(el) {
                const rect = el.getBoundingClientRect();
                return {
                    x: rect.left + rect.width / 2 - parentRect.left,
                    y: rect.top + rect.height - parentRect.top
                };
            }

            function drawCurve(x1, y1, x2, y2) {
                const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                const controlY = (y1 + y2) / 2;
                path.setAttribute('d', `M ${x1} ${y1} C ${x1} ${controlY}, ${x2} ${controlY}, ${x2} ${y2}`);
                path.setAttribute('stroke', '#2d2620'); // Charcoal ink
                path.setAttribute('stroke-width', '3.5');
                path.setAttribute('fill', 'none');
                path.setAttribute('stroke-linecap', 'round');
                path.setAttribute('filter', 'url(#sketch-filter)');
                path.setAttribute('class', 'branch-line');
                canvas.appendChild(path);
            }

            // Mobile view line drawing (Window width < 768px)
            if (window.innerWidth < 768) {
                const allCards = Array.from(document.querySelectorAll('.polaroid-card'));
                if (allCards.length < 2) return;

                // Sort cards by vertical offset in viewport
                allCards.sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top);

                // Draw a simple chain connecting the bottom of each card to the top of the next
                for (let i = 0; i < allCards.length - 1; i++) {
                    const fromPt = getCenterBottom(allCards[i]);
                    const toPt = getCenterTop(allCards[i+1]);
                    drawCurve(fromPt.x, fromPt.y, toPt.x, toPt.y);
                }
            } else {
                // Desktop view tree structure drawing
                const bphCards = Array.from(document.querySelectorAll('#tier-bph .polaroid-card'));
                
                // 1. Connect Leader (Ketua) to BPH Subordinates
                if (bphCards.length > 1) {
                    const leader = bphCards[0];
                    const leaderPt = getCenterBottom(leader);
                    for (let i = 1; i < bphCards.length; i++) {
                        const memberPt = getCenterTop(bphCards[i]);
                        drawCurve(leaderPt.x, leaderPt.y, memberPt.x, memberPt.y);
                    }
                }

                // 2. Connect BPH nodes to division columns
                const divisionCols = Array.from(document.querySelectorAll('#tier-divisions > div'));
                if (bphCards.length > 0 && divisionCols.length > 0) {
                    divisionCols.forEach((col, index) => {
                        // Distribute connections to BPH nodes proportionally
                        const bphIndex = Math.min(Math.floor(index / divisionCols.length * bphCards.length), bphCards.length - 1);
                        const fromCard = bphCards[bphIndex];
                        
                        const fromPt = getCenterBottom(fromCard);
                        const toPt = getCenterTop(col);
                        drawCurve(fromPt.x, fromPt.y, toPt.x, toPt.y);
                    });
                }

                // 3. Connect staff members vertically inside division columns
                divisionCols.forEach(col => {
                    const cardsInCol = Array.from(col.querySelectorAll('.polaroid-card'));
                    for (let i = 0; i < cardsInCol.length - 1; i++) {
                        const fromPt = getCenterBottom(cardsInCol[i]);
                        const toPt = getCenterTop(cardsInCol[i+1]);
                        drawCurve(fromPt.x, fromPt.y, toPt.x, toPt.y);
                    }
                });
            }
        }

        // Draw initially and bind window resizing for layout preservation
        redrawLines();
        window.addEventListener('resize', redrawLines);
    });
</script>
