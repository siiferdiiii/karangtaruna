<%- include('partials/head') %>
<%- include('partials/navbar') %>

<section class="pt-32 pb-24 bg-white min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-center mb-24">
            <div class="relative">
                <img src="https://images.unsplash.com/photo-1511632765486-a01980e01a18?w=600&h=500&fit=crop" alt="Community" class="rounded-3xl shadow-2xl w-full">
                <div class="absolute -bottom-8 -right-8 w-48 h-48 bg-gradient-to-br from-karang-500 to-taruna-600 rounded-3xl flex items-center justify-center shadow-xl">
                    <div class="text-center text-white">
                        <p class="text-4xl font-bold">35</p>
                        <p class="text-sm">Tahun Mengabdi</p>
                    </div>
                </div>
            </div>

            <div class="space-y-6">
                <div class="inline-block px-4 py-1 bg-taruna-100 text-taruna-700 rounded-full text-sm font-semibold">Tentang Kami</div>
                <h2 class="text-4xl font-bold text-gray-900 leading-tight">
                    Membangun Negeri Bersama <span class="text-karang-600">Pemuda Indonesia</span>
                </h2>
                <p class="text-gray-600 leading-relaxed">
                    Karang Taruna didirikan sebagai wadah pengembangan kreativitas, inovasi, dan kontribusi sosial bagi generasi muda Indonesia. Kami percaya bahwa pemuda adalah agen perubahan yang mampu membawa Indonesia menuju masa depan yang lebih baik.
                </p>
                <p class="text-gray-600 leading-relaxed">
                    Dengan semangat kebersamaan dan gotong royong, Karang Taruna terus berkontribusi dalam berbagai bidang mulai dari sosial, pendidikan, lingkungan, hingga kewirausahaan.
                </p>

                <div class="flex gap-4 pt-4">
                    <a href="/kegiatan" class="px-6 py-3 bg-gradient-to-r from-karang-500 to-karang-600 text-white rounded-full font-semibold shadow-lg hover:shadow-xl transition-all">
                        Lihat Kegiatan
                    </a>
                    <a href="/kontak" class="px-6 py-3 border-2 border-gray-300 text-gray-700 rounded-full font-semibold hover:border-karang-500 hover:text-karang-600 transition-all">
                        Hubungi Kami
                    </a>
                </div>
            </div>
        </div>

        <!-- Vision Mission -->
        <div class="grid md:grid-cols-2 gap-8 mb-24">
            <div class="bg-gradient-to-br from-karang-50 to-karang-100 p-8 rounded-3xl border border-karang-200">
                <div class="w-14 h-14 bg-karang-500 rounded-2xl flex items-center justify-center mb-6">
                    <i class="fas fa-eye text-white text-2xl"></i>
                </div>
                <h3 class="text-2xl font-bold text-gray-900 mb-4">Visi</h3>
                <p class="text-gray-700 leading-relaxed">
                    Menjadikan Karang Taruna sebagai organisasi kepemudaan yang unggul, mandiri, dan berkontribusi aktif dalam pembangunan masyarakat, bangsa, dan negara.
                </p>
            </div>
            <div class="bg-gradient-to-br from-taruna-50 to-taruna-100 p-8 rounded-3xl border border-taruna-200">
                <div class="w-14 h-14 bg-taruna-600 rounded-2xl flex items-center justify-center mb-6">
                    <i class="fas fa-bullseye text-white text-2xl"></i>
                </div>
                <h3 class="text-2xl font-bold text-gray-900 mb-4">Misi</h3>
                <ul class="space-y-3 text-gray-700">
                    <li class="flex items-start gap-3"><i class="fas fa-check-circle text-taruna-500 mt-1"></i><span>Mengembangkan potensi dan kreativitas pemuda</span></li>
                    <li class="flex items-start gap-3"><i class="fas fa-check-circle text-taruna-500 mt-1"></i><span>Membangun jaringan kerja sama antar pemuda</span></li>
                    <li class="flex items-start gap-3"><i class="fas fa-check-circle text-taruna-500 mt-1"></i><span>Meningkatkan kontribusi sosial dan lingkungan</span></li>
                    <li class="flex items-start gap-3"><i class="fas fa-check-circle text-taruna-500 mt-1"></i><span>Mendorong kewirausahaan dan inovasi pemuda</span></li>
                </ul>
            </div>
        </div>

        <!-- Programs -->
        <div class="text-center mb-12">
            <h2 class="text-3xl font-bold text-gray-900">Program Unggulan</h2>
            <p class="text-gray-600 mt-2">Empat pilar utama kegiatan Karang Taruna Indonesia</p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="p-6 bg-karang-50 rounded-2xl border border-karang-100 hover:shadow-lg transition-shadow">
                <i class="fas fa-hand-holding-heart text-karang-500 text-3xl mb-4"></i>
                <h3 class="font-bold text-gray-900 text-lg">Sosial & Kemanusiaan</h3>
                <p class="text-sm text-gray-500 mt-2">Program bantuan dan peduli sesama masyarakat.</p>
            </div>
            <div class="p-6 bg-taruna-50 rounded-2xl border border-taruna-100 hover:shadow-lg transition-shadow">
                <i class="fas fa-lightbulb text-taruna-500 text-3xl mb-4"></i>
                <h3 class="font-bold text-gray-900 text-lg">Inovasi & Kreativitas</h3>
                <p class="text-sm text-gray-500 mt-2">Pengembangan ide dan karya pemuda Indonesia.</p>
            </div>
            <div class="p-6 bg-green-50 rounded-2xl border border-green-100 hover:shadow-lg transition-shadow">
                <i class="fas fa-tree text-green-500 text-3xl mb-4"></i>
                <h3 class="font-bold text-gray-900 text-lg">Lingkungan Hidup</h3>
                <p class="text-sm text-gray-500 mt-2">Gerakan peduli dan menjaga lingkungan.</p>
            </div>
            <div class="p-6 bg-purple-50 rounded-2xl border border-purple-100 hover:shadow-lg transition-shadow">
                <i class="fas fa-graduation-cap text-purple-500 text-3xl mb-4"></i>
                <h3 class="font-bold text-gray-900 text-lg">Pendidikan</h3>
                <p class="text-sm text-gray-500 mt-2">Beasiswa dan pelatihan skill pemuda.</p>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
