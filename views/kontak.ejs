<%- include('partials/head') %>
<%- include('partials/navbar') %>

<section class="pt-32 pb-24 bg-gradient-to-br from-karang-50 to-taruna-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <div class="inline-block px-4 py-1 bg-karang-100 text-karang-700 rounded-full text-sm font-semibold mb-4">Hubungi Kami</div>
            <h1 class="text-4xl lg:text-5xl font-bold text-gray-900">Mari Berkolaborasi</h1>
            <p class="text-gray-600 mt-4 max-w-2xl mx-auto">Punya ide kegiatan atau ingin berpartisipasi? Jangan ragu untuk menghubungi kami.</p>
        </div>

        <div class="grid lg:grid-cols-2 gap-16">
            <div class="space-y-8">
                <div class="flex items-start gap-4">
                    <div class="w-14 h-14 bg-white rounded-2xl shadow-md flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-map-marker-alt text-karang-600 text-xl"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-gray-900 text-lg">Alamat</h3>
                        <p class="text-gray-600 mt-1">Jl. Pemuda No. 123, Jakarta Pusat<br>DKI Jakarta 10110, Indonesia</p>
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <div class="w-14 h-14 bg-white rounded-2xl shadow-md flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-phone text-taruna-600 text-xl"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-gray-900 text-lg">Telepon</h3>
                        <p class="text-gray-600 mt-1">+62 21 1234 5678<br>+62 812 3456 7890 (WhatsApp)</p>
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <div class="w-14 h-14 bg-white rounded-2xl shadow-md flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-envelope text-green-600 text-xl"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-gray-900 text-lg">Email</h3>
                        <p class="text-gray-600 mt-1">info@karangtaruna.id<br>partnership@karangtaruna.id</p>
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <div class="w-14 h-14 bg-white rounded-2xl shadow-md flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-clock text-purple-600 text-xl"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-gray-900 text-lg">Jam Operasional</h3>
                        <p class="text-gray-600 mt-1">Senin - Jumat: 08.00 - 17.00 WIB<br>Sabtu: 08.00 - 12.00 WIB</p>
                    </div>
                </div>

                <div class="pt-4">
                    <h3 class="font-bold text-gray-900 mb-4">Ikuti Kami</h3>
                    <div class="flex gap-4">
                        <a href="#" class="w-12 h-12 bg-gray-900 rounded-full flex items-center justify-center text-white hover:bg-karang-500 transition-all hover:scale-110"><i class="fab fa-instagram text-lg"></i></a>
                        <a href="#" class="w-12 h-12 bg-gray-900 rounded-full flex items-center justify-center text-white hover:bg-blue-600 transition-all hover:scale-110"><i class="fab fa-facebook-f text-lg"></i></a>
                        <a href="#" class="w-12 h-12 bg-gray-900 rounded-full flex items-center justify-center text-white hover:bg-sky-500 transition-all hover:scale-110"><i class="fab fa-twitter text-lg"></i></a>
                        <a href="#" class="w-12 h-12 bg-gray-900 rounded-full flex items-center justify-center text-white hover:bg-red-600 transition-all hover:scale-110"><i class="fab fa-youtube text-lg"></i></a>
                        <a href="#" class="w-12 h-12 bg-gray-900 rounded-full flex items-center justify-center text-white hover:bg-green-500 transition-all hover:scale-110"><i class="fab fa-whatsapp text-lg"></i></a>
                    </div>
                </div>
            </div>

            <div class="bg-white p-8 md:p-10 rounded-3xl shadow-xl">
                <% if (success) { %>
                <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-xl flex items-center gap-3">
                    <i class="fas fa-check-circle text-green-500 text-xl"></i>
                    <div>
                        <p class="font-bold text-green-800">Berhasil!</p>
                        <p class="text-green-700 text-sm"><%= message %></p>
                    </div>
                </div>
                <% } %>

                <form action="/kontak" method="POST" class="space-y-6">
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Nama Lengkap *</label>
                            <input type="text" name="nama" required class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-karang-500 focus:ring-2 focus:ring-karang-200 outline-none transition-all" placeholder="Masukkan nama">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Email *</label>
                            <input type="email" name="email" required class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-karang-500 focus:ring-2 focus:ring-karang-200 outline-none transition-all" placeholder="email@example.com">
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Subjek *</label>
                        <input type="text" name="subjek" required class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-karang-500 focus:ring-2 focus:ring-karang-200 outline-none transition-all" placeholder="Subjek pesan">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Pesan *</label>
                        <textarea name="pesan" rows="5" required class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-karang-500 focus:ring-2 focus:ring-karang-200 outline-none transition-all resize-none" placeholder="Tulis pesan Anda..."></textarea>
                    </div>
                    <button type="submit" class="w-full py-4 bg-gradient-to-r from-karang-500 to-taruna-600 text-white rounded-xl font-bold hover:shadow-lg hover:scale-[1.02] transition-all flex items-center justify-center gap-2">
                        <i class="fas fa-paper-plane"></i> Kirim Pesan
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
