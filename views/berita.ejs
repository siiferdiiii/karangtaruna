<%- include('partials/head') %>
<%- include('partials/navbar') %>

<section class="pt-32 pb-24 bg-gray-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <div class="inline-block px-4 py-1 bg-karang-100 text-karang-700 rounded-full text-sm font-semibold mb-4">Informasi Terkini</div>
            <h1 class="text-4xl lg:text-5xl font-bold text-gray-900">Berita & Pengumuman</h1>
            <p class="text-gray-600 mt-4 max-w-2xl mx-auto">Ikuti perkembangan terbaru seputar kegiatan dan program Karang Taruna di seluruh Indonesia</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% berita.forEach((item, index) => { %>
            <article class="news-card bg-white rounded-2xl overflow-hidden shadow-lg transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl flex flex-col">
                <div class="relative h-48 overflow-hidden">
                    <img src="<%= item.gambar %>" alt="<%= item.judul %>" class="w-full h-full object-cover transition-transform duration-500 hover:scale-110">
                    <% if (index < 2) { %>
                    <div class="absolute top-4 left-4 px-3 py-1 bg-karang-500 text-white text-xs font-bold rounded-full">TERBARU</div>
                    <% } %>
                </div>
                <div class="p-6 flex-1 flex flex-col">
                    <div class="flex items-center gap-4 text-sm text-gray-500 mb-3">
                        <span><i class="far fa-calendar-alt mr-1"></i> <%= formatDate(item.tanggal) %></span>
                        <span><i class="far fa-eye mr-1"></i> <%= item.views.toLocaleString('id-ID') %> views</span>
                    </div>
                    <span class="inline-block px-2 py-1 bg-gray-100 text-gray-600 text-xs font-semibold rounded mb-2 w-fit"><%= item.kategori %></span>
                    <h3 class="text-xl font-bold text-gray-900 mb-2 hover:text-karang-600 transition-colors cursor-pointer line-clamp-2">
                        <a href="/berita/<%= item.slug %>"><%= item.judul %></a>
                    </h3>
                    <p class="text-gray-600 text-sm leading-relaxed mb-4 line-clamp-3 flex-1"><%= item.ringkasan %></p>
                    <div class="flex items-center justify-between mt-auto pt-4 border-t border-gray-100">
                        <span class="text-xs text-gray-500"><i class="far fa-user mr-1"></i> <%= item.penulis %></span>
                        <a href="/berita/<%= item.slug %>" class="inline-flex items-center text-karang-600 font-semibold hover:gap-2 transition-all text-sm">
                            Baca <i class="fas fa-arrow-right ml-2"></i>
                        </a>
                    </div>
                </div>
            </article>
            <% }) %>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
