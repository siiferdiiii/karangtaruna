<%- include('partials/head') %>
<%- include('partials/navbar') %>

<section class="pt-32 pb-24 bg-white min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 gap-6">
            <div>
                <div class="inline-block px-4 py-1 bg-taruna-100 text-taruna-700 rounded-full text-sm font-semibold mb-4">Program Unggulan</div>
                <h1 class="text-4xl lg:text-5xl font-bold text-gray-900">Kegiatan Kami</h1>
                <p class="text-gray-600 mt-2 max-w-xl">Berbagai program untuk kemajuan pemuda Indonesia</p>
            </div>
            <div class="flex flex-wrap gap-2">
                <a href="/kegiatan" class="px-5 py-2 rounded-full border-2 font-medium transition-all <%= activeFilter === 'all' ? 'border-karang-500 bg-karang-500 text-white' : 'border-gray-300 text-gray-600 hover:border-karang-500 hover:text-karang-600' %>">Semua</a>
                <a href="/kegiatan?kategori=sosial" class="px-5 py-2 rounded-full border-2 font-medium transition-all <%= activeFilter === 'sosial' ? 'border-karang-500 bg-karang-500 text-white' : 'border-gray-300 text-gray-600 hover:border-karang-500 hover:text-karang-600' %>">Sosial</a>
                <a href="/kegiatan?kategori=edukasi" class="px-5 py-2 rounded-full border-2 font-medium transition-all <%= activeFilter === 'edukasi' ? 'border-karang-500 bg-karang-500 text-white' : 'border-gray-300 text-gray-600 hover:border-karang-500 hover:text-karang-600' %>">Edukasi</a>
                <a href="/kegiatan?kategori=lingkungan" class="px-5 py-2 rounded-full border-2 font-medium transition-all <%= activeFilter === 'lingkungan' ? 'border-karang-500 bg-karang-500 text-white' : 'border-gray-300 text-gray-600 hover:border-karang-500 hover:text-karang-600' %>">Lingkungan</a>
                <a href="/kegiatan?kategori=kreativitas" class="px-5 py-2 rounded-full border-2 font-medium transition-all <%= activeFilter === 'kreativitas' ? 'border-karang-500 bg-karang-500 text-white' : 'border-gray-300 text-gray-600 hover:border-karang-500 hover:text-karang-600' %>">Kreativitas</a>
            </div>
        </div>

        <% if (kegiatan.length === 0) { %>
        <div class="text-center py-20">
            <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-inbox text-gray-400 text-3xl"></i>
            </div>
            <h3 class="text-xl font-bold text-gray-700">Tidak ada kegiatan</h3>
            <p class="text-gray-500 mt-2">Belum ada kegiatan dalam kategori ini.</p>
        </div>
        <% } else { %>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
            <% kegiatan.forEach(item => { %>
            <a href="/kegiatan/<%= item.id %>" class="group relative rounded-2xl overflow-hidden shadow-lg h-80 block hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
                <div class="h-full overflow-hidden">
                    <img src="<%= item.gambar %>" alt="<%= item.judul %>" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                <div class="absolute bottom-0 left-0 right-0 p-6">
                    <span class="inline-block px-3 py-1 
                        <%= item.kategori === 'sosial' ? 'bg-karang-500' : item.kategori === 'lingkungan' ? 'bg-green-500' : item.kategori === 'kreativitas' ? 'bg-purple-500' : 'bg-taruna-500' %> 
                        text-white text-xs font-bold rounded-full mb-2 uppercase tracking-wider"><%= item.kategori %></span>
                    <h3 class="text-white font-bold text-lg leading-snug group-hover:text-karang-300 transition-colors"><%= item.judul %></h3>
                    <p class="text-gray-300 text-sm mt-1"><i class="fas fa-map-marker-alt mr-1"></i> <%= item.lokasi %>, <%= formatDateShort(item.tanggal) %></p>
                    <p class="text-gray-400 text-xs mt-2 line-clamp-2"><%= stripHtml(item.deskripsi) %></p>
                </div>
            </a>
            <% }) %>
        </div>
        <% } %>
    </div>
</section>


<%- include('partials/footer') %>
<%- include('partials/scripts') %>
