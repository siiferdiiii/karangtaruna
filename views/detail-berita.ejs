<%- include('partials/head') %>
<%- include('partials/navbar') %>

<section class="pt-32 pb-24 bg-white min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb -->
        <nav class="flex items-center text-sm text-gray-500 mb-8">
            <a href="/" class="hover:text-karang-600 transition-colors">Beranda</a>
            <i class="fas fa-chevron-right mx-2 text-xs"></i>
            <a href="/berita" class="hover:text-karang-600 transition-colors">Berita</a>
            <i class="fas fa-chevron-right mx-2 text-xs"></i>
            <span class="text-gray-700 truncate max-w-xs"><%= item.judul %></span>
        </nav>

        <article class="mt-6">
            <!-- Article Header Section -->
            <div class="mb-8">
                <span class="inline-block px-4 py-1.5 bg-karang-100 text-karang-700 text-xs font-bold rounded-full mb-4 uppercase tracking-wider"><%= item.kategori %></span>
                <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 leading-tight mb-6"><%= item.judul %></h1>
                
                <div class="flex flex-wrap items-center gap-6 text-sm text-gray-500 pb-6 border-b border-gray-100">
                    <span><i class="far fa-calendar-alt mr-1.5 text-karang-500"></i> <%= formatDate(item.tanggal) %></span>
                    <span><i class="far fa-user mr-1.5 text-karang-500"></i> <%= item.penulis %></span>
                    <span><i class="far fa-eye mr-1.5 text-karang-500"></i> <%= item.views.toLocaleString('id-ID') %> views</span>
                    <div class="flex flex-wrap gap-2">
                        <% item.tag.forEach(t => { %>
                        <span class="px-2 py-0.5 bg-gray-100 text-gray-600 text-xs rounded">#<%= t %></span>
                        <% }) %>
                    </div>
                </div>
            </div>

            <!-- Full-Screen Featured Image -->
            <div class="relative h-64 md:h-[450px] w-full rounded-3xl overflow-hidden shadow-md mb-10">
                <img src="<%= item.gambar %>" alt="<%= item.judul %>" class="w-full h-full object-cover">
            </div>

            <!-- Article Body -->
            <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed article-content">
                <%- item.konten %>
            </div>

            <!-- Social Share Bar -->
            <div class="mt-12 pt-8 border-t border-gray-100 flex items-center justify-between">
                <span class="text-gray-500 text-sm font-semibold">Bagikan artikel:</span>
                <div class="flex gap-3">
                    <a id="share-facebook" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-blue-600 text-white flex items-center justify-center hover:scale-110 hover:shadow-lg transition-all" title="Bagikan ke Facebook">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                    <a id="share-twitter" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-sky-500 text-white flex items-center justify-center hover:scale-110 hover:shadow-lg transition-all" title="Bagikan ke Twitter">
                        <i class="fab fa-twitter"></i>
                    </a>
                    <a id="share-whatsapp" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-green-500 text-white flex items-center justify-center hover:scale-110 hover:shadow-lg transition-all" title="Bagikan ke WhatsApp">
                        <i class="fab fa-whatsapp"></i>
                    </a>
                    <button id="share-copy" class="w-10 h-10 rounded-full bg-gray-800 text-white flex items-center justify-center hover:scale-110 hover:shadow-lg transition-all cursor-pointer relative" title="Salin Tautan">
                        <i class="fas fa-link"></i>
                        <span id="copy-tooltip" class="absolute -top-10 left-1/2 -translate-x-1/2 bg-gray-900 text-white text-xs py-1.5 px-3 rounded-lg opacity-0 transition-opacity duration-300 pointer-events-none whitespace-nowrap shadow-md">
                            Tautan disalin!
                        </span>
                    </button>
                </div>
            </div>
        </article>

        <!-- Related News -->
        <% if (related.length > 0) { %>
        <div class="mt-16">
            <h2 class="text-2xl font-bold text-gray-900 mb-8">Berita Terkait</h2>
            <div class="grid md:grid-cols-3 gap-6">
                <% related.forEach(rel => { %>
                <a href="/berita/<%= rel.slug %>" class="group bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border border-gray-50">
                    <div class="h-40 overflow-hidden">
                        <img src="<%= rel.gambar %>" alt="<%= rel.judul %>" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                    </div>
                    <div class="p-4">
                        <span class="text-xs text-karang-600 font-semibold"><%= rel.kategori %></span>
                        <h3 class="font-bold text-gray-900 mt-1 line-clamp-2 group-hover:text-karang-600 transition-colors"><%= rel.judul %></h3>
                    </div>
                </a>
                <% }) %>
            </div>
        </div>
        <% } %>

        <!-- Popular News -->
        <% if (typeof populer !== 'undefined' && populer && populer.length > 0) { %>
        <div class="mt-16 pt-12 border-t border-gray-100">
            <h2 class="text-2xl font-bold text-gray-900 mb-8">Berita Populer</h2>
            <div class="grid md:grid-cols-3 gap-6">
                <% populer.forEach(pop => { %>
                <a href="/berita/<%= pop.slug %>" class="group bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border border-gray-50 flex flex-col">
                    <div class="h-40 overflow-hidden relative shrink-0">
                        <img src="<%= pop.gambar %>" alt="<%= pop.judul %>" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-60"></div>
                        <span class="absolute top-4 left-4 inline-block px-3 py-1 bg-taruna-500 text-white text-xs font-bold rounded-full uppercase tracking-wider shadow-sm">
                            <i class="far fa-eye mr-1"></i> <%= pop.views.toLocaleString('id-ID') %>
                        </span>
                    </div>
                    <div class="p-4 flex-1 flex flex-col justify-between">
                        <div>
                            <span class="text-xs text-karang-600 font-semibold"><%= pop.kategori %></span>
                            <h3 class="font-bold text-gray-900 mt-1 line-clamp-2 group-hover:text-karang-600 transition-colors"><%= pop.judul %></h3>
                        </div>
                        <div class="text-xs text-gray-400 mt-4 pt-3 border-t border-gray-50 flex items-center justify-between">
                            <span><%= formatDateShort(pop.tanggal) %></span>
                            <span><%= pop.penulis %></span>
                        </div>
                    </div>
                </a>
                <% }) %>
            </div>
        </div>
        <% } %>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const pageUrl = encodeURIComponent(window.location.href);
    const pageTitle = encodeURIComponent("<%= item.judul %>");

    const fbBtn = document.getElementById('share-facebook');
    const twBtn = document.getElementById('share-twitter');
    const waBtn = document.getElementById('share-whatsapp');
    const copyBtn = document.getElementById('share-copy');
    const copyTooltip = document.getElementById('copy-tooltip');

    if (fbBtn) fbBtn.href = `https://www.facebook.com/sharer/sharer.php?u=${pageUrl}`;
    if (twBtn) twBtn.href = `https://twitter.com/intent/tweet?url=${pageUrl}&text=${pageTitle}`;
    if (waBtn) waBtn.href = `https://api.whatsapp.com/send?text=${pageTitle}%20${pageUrl}`;

    if (copyBtn) {
        copyBtn.addEventListener('click', function() {
            navigator.clipboard.writeText(window.location.href).then(function() {
                if (copyTooltip) {
                    copyTooltip.classList.remove('opacity-0');
                    copyTooltip.classList.add('opacity-100');
                    setTimeout(function() {
                        copyTooltip.classList.remove('opacity-100');
                        copyTooltip.classList.add('opacity-0');
                    }, 2000);
                }
            }).catch(function(err) {
                console.error('Gagal menyalin tautan: ', err);
            });
        });
    }
});
</script>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
