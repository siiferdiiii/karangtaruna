<%- include('partials/head') %>
<%- include('partials/navbar') %>

<section class="pt-32 pb-24 bg-gray-50 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb -->
        <nav class="flex items-center text-sm text-gray-500 mb-6">
            <a href="/" class="hover:text-karang-600">Beranda</a>
            <i class="fas fa-chevron-right mx-2 text-xs"></i>
            <a href="/berita" class="hover:text-karang-600">Berita</a>
            <i class="fas fa-chevron-right mx-2 text-xs"></i>
            <span class="text-gray-700 truncate max-w-xs"><%= item.judul %></span>
        </nav>

        <article class="bg-white rounded-3xl shadow-xl overflow-hidden">
            <div class="relative h-64 md:h-96">
                <img src="<%= item.gambar %>" alt="<%= item.judul %>" class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                <div class="absolute bottom-0 left-0 right-0 p-6 md:p-10">
                    <span class="inline-block px-3 py-1 bg-karang-500 text-white text-sm font-bold rounded-full mb-3"><%= item.kategori %></span>
                    <h1 class="text-2xl md:text-4xl font-bold text-white leading-tight"><%= item.judul %></h1>
                </div>
            </div>

            <div class="p-6 md:p-10">
                <div class="flex flex-wrap items-center gap-6 text-sm text-gray-500 mb-8 pb-8 border-b border-gray-100">
                    <span><i class="far fa-calendar-alt mr-1"></i> <%= formatDate(item.tanggal) %></span>
                    <span><i class="far fa-user mr-1"></i> <%= item.penulis %></span>
                    <span><i class="far fa-eye mr-1"></i> <%= item.views.toLocaleString('id-ID') %> views</span>
                    <div class="flex gap-2">
                        <% item.tag.forEach(t => { %>
                        <span class="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded">#<%= t %></span>
                        <% }) %>
                    </div>
                </div>

                <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed">
                    <%- item.konten %>
                </div>

                <div class="mt-10 pt-8 border-t border-gray-100 flex items-center justify-between">
                    <span class="text-gray-500 text-sm">Bagikan artikel:</span>
                    <div class="flex gap-3">
                        <button class="w-10 h-10 rounded-full bg-blue-600 text-white flex items-center justify-center hover:scale-110 transition-transform"><i class="fab fa-facebook-f"></i></button>
                        <button class="w-10 h-10 rounded-full bg-sky-500 text-white flex items-center justify-center hover:scale-110 transition-transform"><i class="fab fa-twitter"></i></button>
                        <button class="w-10 h-10 rounded-full bg-green-500 text-white flex items-center justify-center hover:scale-110 transition-transform"><i class="fab fa-whatsapp"></i></button>
                        <button class="w-10 h-10 rounded-full bg-gray-800 text-white flex items-center justify-center hover:scale-110 transition-transform"><i class="fas fa-link"></i></button>
                    </div>
                </div>
            </div>
        </article>

        <!-- Related News -->
        <% if (related.length > 0) { %>
        <div class="mt-16">
            <h2 class="text-2xl font-bold text-gray-900 mb-8">Berita Terkait</h2>
            <div class="grid md:grid-cols-3 gap-6">
                <% related.forEach(rel => { %>
                <a href="/berita/<%= rel.slug %>" class="group bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300">
                    <div class="h-40 overflow-hidden">
                        <img src="<%= rel.gambar %>" alt="<%= rel.judul %>" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                    </div>
                    <div class="p-4">
                        <span class="text-xs text-karang-600 font-semibold"><%= rel.kategori %></span>
                        <h3 class="font-bold text-gray-900 mt-1 line-clamp-2 group-hover:text-karang-600 transition-colors"><%= rel.judul %></h3>
                    </div>
                </a>
                <% }) %>
            </div>
        </div>
        <% } %>
    </div>
</section>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
