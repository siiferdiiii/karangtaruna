<%- include('partials/head') %>
<%- include('partials/navbar') %>

<!-- ─────────────────────────────────────────────────────────────── -->
<!-- HERO: Fullscreen Slider ala umkm.go.id                        -->
<!-- ─────────────────────────────────────────────────────────────── -->
<section id="hero-slider" class="hero-fullscreen relative w-full overflow-hidden" style="height:100vh;">

    <!-- ── Slides ─────────────────────────────────────────── -->
    <% if (berita && berita.length > 0) { %>
        <% berita.forEach((b, i) => { %>
        <div class="hero-slide absolute inset-0 transition-opacity duration-1000 ease-in-out" data-index="<%= i %>" style="opacity:<%= i===0?1:0 %>;z-index:<%= i===0?1:0 %>;">
            <!-- Background image -->
            <img src="<%= b.gambar %>" alt="<%= b.judul %>"
                 class="w-full h-full object-cover"
                 loading="<%= i===0 ? 'eager' : 'lazy' %>">

            <!-- Dark overlay gradient -->
            <div class="hero-slide-overlay absolute inset-0" style="background:linear-gradient(to top, rgba(0,0,0,0.80) 0%, rgba(0,0,0,0.35) 50%, rgba(0,0,0,0.15) 100%);"></div>

            <!-- Slide content: bottom-left text -->
            <div class="hero-slide-content absolute bottom-24 left-0 right-0 px-8 md:px-16 lg:px-24 z-10 max-w-4xl">
                <% if (b.kategori) { %>
                <span class="hero-kategori inline-block px-3 py-1 text-xs font-bold uppercase tracking-widest rounded-full mb-4 text-white" style="background:rgba(249,115,22,0.85);">
                    <%= b.kategori %>
                </span>
                <% } %>
                <h2 class="hero-title text-white font-bold leading-tight mb-5">
                    <%= b.judul %>
                </h2>
                <a href="/berita/<%= b.slug %>" class="hero-cta-btn inline-flex items-center gap-2 text-white border border-white/70 px-7 py-3 rounded-full font-semibold hover:bg-white hover:text-gray-900 transition-all duration-300 backdrop-blur-sm bg-white/10">
                    Selengkapnya
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                </a>
            </div>
        </div>
        <% }) %>
    <% } else { %>
        <!-- Fallback slide jika belum ada berita -->
        <div class="hero-slide absolute inset-0" style="opacity:1;z-index:1;">
            <img src="<%= s.hero_image||'https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=1600&h=900&fit=crop' %>"
                 alt="Karang Taruna" class="w-full h-full object-cover">
            <div class="absolute inset-0" style="background:linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0.1) 100%);"></div>
            <div class="absolute bottom-24 left-0 px-8 md:px-16 lg:px-24 z-10 max-w-4xl">
                <h2 class="hero-title text-white font-bold leading-tight mb-5">
                    <%= s.hero_title_line1 || 'Generasi Muda' %> <%= s.hero_title_line2 || 'Indonesia Emas' %>
                </h2>
                <a href="/kegiatan" class="hero-cta-btn inline-flex items-center gap-2 text-white border border-white/70 px-7 py-3 rounded-full font-semibold hover:bg-white hover:text-gray-900 transition-all duration-300 backdrop-blur-sm bg-white/10">
                    Jelajahi Kegiatan
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                </a>
            </div>
        </div>
    <% } %>

    <!-- ── Prev / Next Arrows ──────────────────────────────── -->
    <% if (berita && berita.length > 1) { %>
    <button id="hero-prev" onclick="heroPrev()" class="hero-arrow absolute left-4 md:left-8 top-1/2 -translate-y-1/2 z-20 w-12 h-12 flex items-center justify-center rounded-full text-white transition-all duration-200" aria-label="Slide sebelumnya">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
    </button>
    <button id="hero-next" onclick="heroNext()" class="hero-arrow absolute right-4 md:right-8 top-1/2 -translate-y-1/2 z-20 w-12 h-12 flex items-center justify-center rounded-full text-white transition-all duration-200" aria-label="Slide berikutnya">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
    </button>

    <!-- ── Dots Indicator ──────────────────────────────────── -->
    <div class="hero-dots absolute bottom-20 left-1/2 -translate-x-1/2 z-20 flex gap-2">
        <% berita.forEach((b, i) => { %>
        <button class="hero-dot w-2.5 h-2.5 rounded-full transition-all duration-300 focus:outline-none"
                data-dot="<%= i %>"
                onclick="heroGoTo(<%= i %>)"
                style="background:<%= i===0 ? 'white' : 'rgba(255,255,255,0.4)' %>;"
                aria-label="Slide <%= i+1 %>">
        </button>
        <% }) %>
    </div>
    <% } %>

    <!-- ── News Flash Ticker (di bawah hero, sticky) ─────── -->
    <div class="news-flash-bar absolute bottom-0 left-0 right-0 z-20 flex items-center overflow-hidden" style="height:48px;">
        <!-- Label -->
        <div class="news-flash-label flex items-center px-4 h-full flex-shrink-0">
            <span class="text-white text-xs font-bold uppercase tracking-wider whitespace-nowrap">
                <i class="fas fa-bolt mr-1.5"></i> News Flash
            </span>
        </div>
        <!-- Scrolling text -->
        <div class="news-flash-ticker flex-1 overflow-hidden relative">
            <div class="news-flash-inner whitespace-nowrap" id="newsFlashInner">
                <% if (berita && berita.length > 0) { %>
                    <% berita.forEach((b, i) => { %>
                    <a href="/berita/<%= b.slug %>" class="news-flash-item text-white/90 text-sm hover:text-white transition-colors">
                        <%= b.judul %>
                    </a>
                    <% if (i < berita.length - 1) { %>
                    <span class="news-flash-sep text-white/40 mx-4">|</span>
                    <% } %>
                    <% }) %>
                    <!-- Duplicate for seamless loop -->
                    <span class="news-flash-sep text-white/40 mx-4">|</span>
                    <% berita.forEach((b, i) => { %>
                    <a href="/berita/<%= b.slug %>" class="news-flash-item text-white/90 text-sm hover:text-white transition-colors">
                        <%= b.judul %>
                    </a>
                    <% if (i < berita.length - 1) { %>
                    <span class="news-flash-sep text-white/40 mx-4">|</span>
                    <% } %>
                    <% }) %>
                <% } else if (s.marquee_text) { %>
                    <span class="text-white/90 text-sm"><%= s.marquee_text %></span>
                <% } else { %>
                    <span class="text-white/90 text-sm">Selamat datang di website resmi Karang Taruna Kelurahan Tanjung, Kabupaten Mempawah</span>
                <% } %>
            </div>
        </div>
    </div>
</section>

<!-- Slider JS (inline, runs immediately after DOM) -->
<script>
(function() {
    var slides = document.querySelectorAll('.hero-slide');
    var dots   = document.querySelectorAll('.hero-dot');
    var cur    = 0;
    var timer  = null;

    function showSlide(n) {
        if (!slides.length) return;
        slides[cur].style.opacity = 0;
        slides[cur].style.zIndex  = 0;
        if (dots[cur]) dots[cur].style.background = 'rgba(255,255,255,0.4)';
        cur = (n + slides.length) % slides.length;
        slides[cur].style.opacity = 1;
        slides[cur].style.zIndex  = 1;
        if (dots[cur]) dots[cur].style.background = 'white';
    }

    window.heroGoTo = function(n) { clearInterval(timer); showSlide(n); startAuto(); }
    window.heroNext = function()  { clearInterval(timer); showSlide(cur + 1); startAuto(); }
    window.heroPrev = function()  { clearInterval(timer); showSlide(cur - 1); startAuto(); }

    function startAuto() {
        if (slides.length > 1) timer = setInterval(function(){ showSlide(cur + 1); }, 6000);
    }
    startAuto();
})();
</script>

<!-- ─────────────────────────────────────────────────────────────── -->
<!-- LATEST NEWS                                                    -->
<!-- ─────────────────────────────────────────────────────────────── -->
<section class="py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-end mb-12">
            <div>
                <div class="inline-block px-4 py-1 bg-karang-100 text-karang-700 rounded-full text-sm font-semibold mb-4">Informasi Terkini</div>
                <h2 class="text-4xl font-bold text-gray-900">Berita Terbaru</h2>
            </div>
            <a href="/berita" class="hidden md:flex items-center text-karang-600 font-semibold hover:gap-2 transition-all">Lihat Semua <i class="fas fa-arrow-right ml-2"></i></a>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% berita.forEach((item, index) => { %>
            <article class="news-card bg-white rounded-2xl overflow-hidden shadow-lg transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl">
                <div class="relative h-48 overflow-hidden">
                    <img src="<%= item.gambar %>" alt="<%= item.judul %>" class="w-full h-full object-cover transition-transform duration-500 hover:scale-110">
                    <% if (index===0) { %><div class="absolute top-4 left-4 px-3 py-1 bg-karang-500 text-white text-xs font-bold rounded-full">TERBARU</div><% } %>
                </div>
                <div class="p-6">
                    <div class="flex items-center gap-4 text-sm text-gray-500 mb-3">
                        <span><i class="far fa-calendar-alt mr-1"></i> <%= formatDate(item.tanggal) %></span>
                        <span><i class="far fa-eye mr-1"></i> <%= item.views.toLocaleString('id-ID') %> views</span>
                    </div>
                    <span class="inline-block px-2 py-1 bg-gray-100 text-gray-600 text-xs font-semibold rounded mb-2"><%= item.kategori %></span>
                    <h3 class="text-xl font-bold text-gray-900 mb-2 hover:text-karang-600 transition-colors cursor-pointer line-clamp-2"><a href="/berita/<%= item.slug %>"><%= item.judul %></a></h3>
                    <p class="text-gray-600 text-sm leading-relaxed mb-4 line-clamp-3"><%= item.ringkasan %></p>
                    <a href="/berita/<%= item.slug %>" class="inline-flex items-center text-karang-600 font-semibold hover:gap-2 transition-all">Baca Selengkapnya <i class="fas fa-arrow-right ml-2"></i></a>
                </div>
            </article>
            <% }) %>
        </div>
        <div class="text-center mt-8 md:hidden">
            <a href="/berita" class="inline-flex items-center px-6 py-3 border-2 border-karang-500 text-karang-600 rounded-full font-semibold hover:bg-karang-500 hover:text-white transition-all">Lihat Semua Berita <i class="fas fa-newspaper ml-2"></i></a>
        </div>
    </div>
</section>

<!-- ─────────────────────────────────────────────────────────────── -->
<!-- ACTIVITIES                                                     -->
<!-- ─────────────────────────────────────────────────────────────── -->
<section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <div class="inline-block px-4 py-1 bg-taruna-100 text-taruna-700 rounded-full text-sm font-semibold mb-4">Program Unggulan</div>
            <h2 class="text-4xl font-bold text-gray-900">Kegiatan Kami</h2>
            <p class="text-gray-600 mt-4 max-w-2xl mx-auto">Berbagai program dan kegiatan yang kami selenggarakan untuk kemajuan pemuda Indonesia</p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
            <% kegiatan.forEach(item => { %>
            <a href="/kegiatan/<%= item.id %>" class="group relative rounded-2xl overflow-hidden shadow-lg h-72 block hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
                <div class="h-full overflow-hidden"><img src="<%= item.gambar %>" alt="<%= item.judul %>" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                <div class="absolute bottom-0 left-0 right-0 p-6">
                    <span class="inline-block px-3 py-1 <%= item.kategori==='sosial'?'bg-karang-500':item.kategori==='lingkungan'?'bg-green-500':item.kategori==='kreativitas'?'bg-purple-500':'bg-taruna-500' %> text-white text-xs font-bold rounded-full mb-2 uppercase tracking-wider"><%= item.kategori %></span>
                    <h3 class="text-white font-bold text-lg leading-snug group-hover:text-karang-300 transition-colors"><%= item.judul %></h3>
                    <p class="text-gray-300 text-sm mt-1"><i class="fas fa-map-marker-alt mr-1"></i> <%= item.lokasi %>, <%= formatDateShort(item.tanggal) %></p>
                </div>
            </a>
            <% }) %>
        </div>
        <div class="text-center mt-12">
            <a href="/kegiatan" class="inline-flex items-center px-8 py-3 border-2 border-karang-500 text-karang-600 rounded-full font-semibold hover:bg-karang-500 hover:text-white transition-all">Lihat Semua Kegiatan <i class="fas fa-calendar-alt ml-2"></i></a>
        </div>
    </div>
</section>

<!-- ─────────────────────────────────────────────────────────────── -->
<!-- COLLABORATORS                                                  -->
<!-- ─────────────────────────────────────────────────────────────── -->
<% if (typeof kolaborator !== 'undefined' && kolaborator && kolaborator.length > 0) { %>
<section class="py-16 bg-gray-50 border-t border-gray-100 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-10 text-center">
        <span class="inline-block px-4 py-1 bg-karang-100 text-karang-700 rounded-full text-sm font-semibold mb-4">Mitra &amp; Partner</span>
        <h2 class="text-3xl font-bold text-gray-900">Kolaborasi Kami</h2>
        <p class="text-gray-500 mt-2">Bekerjasama dengan berbagai instansi dan mitra untuk kemajuan masyarakat</p>
    </div>
    <div class="logo-marquee-container relative w-full overflow-x-hidden py-4 bg-white border-y border-gray-100">
        <div class="absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-white to-transparent z-10 pointer-events-none"></div>
        <div class="absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-white to-transparent z-10 pointer-events-none"></div>
        <div class="logo-marquee-track flex gap-16 animate-logo-marquee whitespace-nowrap">
            <div class="flex items-center gap-16 shrink-0">
                <% for (let i = 0; i < 4; i++) { %>
                    <% kolaborator.forEach(item => { %>
                        <% if (item.link) { %>
                            <a href="<%= item.link %>" target="_blank" rel="noopener noreferrer" class="logo-marquee-item block hover:scale-105 transition-transform duration-300 shrink-0" title="<%= item.nama %>">
                                <img src="<%= item.logo %>" alt="<%= item.nama %>" class="h-12 w-auto max-w-[150px] object-contain filter grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300">
                            </a>
                        <% } else { %>
                            <div class="logo-marquee-item shrink-0" title="<%= item.nama %>">
                                <img src="<%= item.logo %>" alt="<%= item.nama %>" class="h-12 w-auto max-w-[150px] object-contain filter grayscale opacity-60 hover:scale-105 hover:grayscale-0 hover:opacity-100 transition-all duration-300">
                            </div>
                        <% } %>
                    <% }) %>
                <% } %>
            </div>
            <div class="flex items-center gap-16 shrink-0" aria-hidden="true">
                <% for (let i = 0; i < 4; i++) { %>
                    <% kolaborator.forEach(item => { %>
                        <% if (item.link) { %>
                            <a href="<%= item.link %>" target="_blank" rel="noopener noreferrer" class="logo-marquee-item block hover:scale-105 transition-transform duration-300 shrink-0" title="<%= item.nama %>">
                                <img src="<%= item.logo %>" alt="<%= item.nama %>" class="h-12 w-auto max-w-[150px] object-contain filter grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300">
                            </a>
                        <% } else { %>
                            <div class="logo-marquee-item shrink-0" title="<%= item.nama %>">
                                <img src="<%= item.logo %>" alt="<%= item.nama %>" class="h-12 w-auto max-w-[150px] object-contain filter grayscale opacity-60 hover:scale-105 hover:grayscale-0 hover:opacity-100 transition-all duration-300">
                            </div>
                        <% } %>
                    <% }) %>
                <% } %>
            </div>
        </div>
    </div>
</section>
<% } %>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
