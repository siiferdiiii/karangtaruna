<%- include('partials/head') %>
<%- include('partials/navbar') %>

<section class="pt-32 pb-24 bg-white min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb -->
        <nav class="flex items-center text-sm text-gray-500 mb-8">
            <a href="/" class="hover:text-karang-600 transition-colors">Beranda</a>
            <i class="fas fa-chevron-right mx-2 text-xs"></i>
            <a href="/kegiatan" class="hover:text-karang-600 transition-colors">Kegiatan</a>
            <i class="fas fa-chevron-right mx-2 text-xs"></i>
            <span class="text-gray-700 truncate max-w-xs"><%= item.judul %></span>
        </nav>

        <article class="mt-6">
            <!-- Header Section -->
            <div class="mb-8">
                <span class="inline-block px-4 py-1.5 text-white text-xs font-bold rounded-full mb-4 uppercase tracking-wider
                    <%= item.kategori === 'sosial' ? 'bg-karang-500' : item.kategori === 'lingkungan' ? 'bg-green-500' : item.kategori === 'kreativitas' ? 'bg-purple-500' : 'bg-taruna-500' %>">
                    <%= item.kategori %>
                </span>
                <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 leading-tight mb-4"><%= item.judul %></h1>
            </div>

            <!-- Featured Image (Full bleed-style) -->
            <div class="relative h-64 md:h-[450px] w-full rounded-3xl overflow-hidden shadow-md mb-12">
                <img src="<%= item.gambar %>" alt="<%= item.judul %>" class="w-full h-full object-cover">
            </div>

            <!-- Split Content Grid -->
            <div class="grid lg:grid-cols-3 gap-12 items-start">
                
                <!-- Main Content Left (2 Columns) -->
                <div class="lg:col-span-2 space-y-8">
                    <div>
                        <h2 class="text-2xl font-bold text-gray-900 mb-4 pb-2 border-b border-gray-100">Deskripsi Kegiatan</h2>
                        <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed description-content">
                            <%- item.deskripsi %>
                        </div>
                    </div>

                    <!-- Share Section -->
                    <div class="pt-8 border-t border-gray-100 flex items-center justify-between">
                        <span class="text-gray-500 text-sm font-semibold">Bagikan kegiatan:</span>
                        <div class="flex gap-3">
                            <a id="share-facebook" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-blue-600 text-white flex items-center justify-center hover:scale-110 hover:shadow-lg transition-all" title="Bagikan ke Facebook">
                                <i class="fab fa-facebook-f"></i>
                            </a>
                            <a id="share-twitter" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-sky-500 text-white flex items-center justify-center hover:scale-110 hover:shadow-lg transition-all" title="Bagikan ke Twitter">
                                <i class="fab fa-twitter"></i>
                            </a>
                            <a id="share-whatsapp" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-green-500 text-white flex items-center justify-center hover:scale-110 hover:shadow-lg transition-all" title="Bagikan ke WhatsApp">
                                <i class="fab fa-whatsapp"></i>
                            </a>
                            <button id="share-copy" class="w-10 h-10 rounded-full bg-gray-800 text-white flex items-center justify-center hover:scale-110 hover:shadow-lg transition-all cursor-pointer relative" title="Salin Tautan">
                                <i class="fas fa-link"></i>
                                <span id="copy-tooltip" class="absolute -top-10 left-1/2 -translate-x-1/2 bg-gray-900 text-white text-xs py-1.5 px-3 rounded-lg opacity-0 transition-opacity duration-300 pointer-events-none whitespace-nowrap shadow-md">
                                    Tautan disalin!
                                </span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Detail / Call to Action Panel Right (1 Column) -->
                <div class="lg:sticky lg:top-32 space-y-6">
                    <div class="bg-gray-50 border border-gray-100 rounded-3xl p-6 sm:p-8 shadow-sm">
                        <h3 class="text-lg font-bold text-gray-900 mb-6">Informasi Kegiatan</h3>
                        
                        <div class="space-y-5 mb-8">
                            <!-- Lokasi -->
                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-xl bg-karang-100 text-karang-600 flex items-center justify-center shrink-0">
                                    <i class="fas fa-map-marker-alt text-base"></i>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Lokasi</p>
                                    <p class="font-bold text-gray-800 text-sm sm:text-base"><%= item.lokasi || '-' %></p>
                                </div>
                            </div>
                            
                            <!-- Tanggal -->
                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-xl bg-taruna-100 text-taruna-600 flex items-center justify-center shrink-0">
                                    <i class="far fa-calendar-alt text-base"></i>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Tanggal Kegiatan Dimulai</p>
                                    <p class="font-bold text-gray-800 text-sm sm:text-base"><%= formatDate(item.tanggal) %></p>
                                </div>
                            </div>

                            <!-- Periode Pendaftaran -->
                            <% if (item.buka_pendaftaran && (item.pendaftaran_dibuka || item.pendaftaran_ditutup)) { %>
                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-xl bg-green-100 text-green-600 flex items-center justify-center shrink-0">
                                    <i class="fas fa-user-clock text-base"></i>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Periode Pendaftaran</p>
                                    <p class="font-bold text-gray-800 text-xs sm:text-sm leading-relaxed">
                                        <%= item.pendaftaran_dibuka ? formatDate(item.pendaftaran_dibuka) : 'Mulai Sekarang' %> 
                                        <br><span class="text-gray-400 font-normal">s.d.</span> <br>
                                        <%= item.pendaftaran_ditutup ? formatDate(item.pendaftaran_ditutup) : 'Selesai' %>
                                    </p>
                                </div>
                            </div>
                            <% } %>

                            <!-- Status Pendaftaran -->
                            <% 
                                var todayStr = new Date().toISOString().split('T')[0];
                                var isOpen = item.buka_pendaftaran;
                                var statusMsg = 'Ditutup';
                                var statusClass = 'bg-gray-300 text-gray-600';
                                
                                if (isOpen) {
                                    if (item.pendaftaran_dibuka && todayStr < new Date(item.pendaftaran_dibuka).toISOString().split('T')[0]) {
                                        isOpen = false;
                                        statusMsg = 'Belum Dibuka';
                                        statusClass = 'bg-yellow-200 text-yellow-800';
                                    } else if (item.pendaftaran_ditutup && todayStr > new Date(item.pendaftaran_ditutup).toISOString().split('T')[0]) {
                                        isOpen = false;
                                        statusMsg = 'Selesai / Ditutup';
                                        statusClass = 'bg-red-200 text-red-800';
                                    } else {
                                        statusMsg = 'Dibuka';
                                        statusClass = 'bg-green-200 text-green-800';
                                    }
                                }
                            %>
                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-xl <%= isOpen ? 'bg-green-100 text-green-600' : 'bg-gray-200 text-gray-500' %> flex items-center justify-center shrink-0">
                                    <i class="fas <%= isOpen ? 'fa-door-open' : 'fa-door-closed' %> text-base"></i>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Status Registrasi</p>
                                    <span class="inline-block px-2.5 py-0.5 mt-0.5 rounded-full text-xs font-bold uppercase tracking-wider <%= statusClass %>">
                                        <%= statusMsg %>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- CTA Button -->
                        <% if (isOpen) { %>
                            <a href="/daftar-kegiatan/<%= item.id %>" class="w-full py-4 bg-gradient-to-r from-karang-500 to-karang-600 text-white rounded-2xl font-bold shadow-lg hover:shadow-xl hover:scale-[1.02] transition-all flex items-center justify-center gap-2 text-center animate-pulse">
                                <i class="fas fa-user-plus"></i> Daftar Sekarang
                            </a>
                        <% } else { %>
                            <% 
                                var btnMsg = 'Pendaftaran Ditutup';
                                if (item.buka_pendaftaran && item.pendaftaran_dibuka && todayStr < new Date(item.pendaftaran_dibuka).toISOString().split('T')[0]) {
                                    btnMsg = 'Belum Dibuka';
                                }
                            %>
                            <button disabled class="w-full py-4 bg-gray-200 text-gray-400 rounded-2xl font-bold cursor-not-allowed flex items-center justify-center gap-2 text-center">
                                <i class="fas fa-lock"></i> <%= btnMsg %>
                            </button>
                        <% } %>
                    </div>
                </div>
            </div>
        </article>

        <!-- Related Activities Section -->
        <% if (related.length > 0) { %>
        <div class="mt-20 pt-12 border-t border-gray-100">
            <h2 class="text-2xl font-bold text-gray-900 mb-8">Kegiatan Terkait</h2>
            <div class="grid md:grid-cols-3 gap-8">
                <% related.forEach(rel => { %>
                <a href="/kegiatan/<%= rel.id %>" class="group bg-white rounded-3xl overflow-hidden shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border border-gray-50 flex flex-col">
                    <div class="h-48 overflow-hidden relative shrink-0">
                        <img src="<%= rel.gambar %>" alt="<%= rel.judul %>" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-60"></div>
                        <span class="absolute top-4 left-4 inline-block px-3 py-1 text-white text-xs font-bold rounded-full uppercase tracking-wider
                            <%= rel.kategori === 'sosial' ? 'bg-karang-500' : rel.kategori === 'lingkungan' ? 'bg-green-500' : rel.kategori === 'kreativitas' ? 'bg-purple-500' : 'bg-taruna-500' %>">
                            <%= rel.kategori %>
                        </span>
                    </div>
                    <div class="p-5 flex-1 flex flex-col justify-between">
                        <div>
                            <h3 class="font-bold text-gray-900 text-lg line-clamp-2 group-hover:text-karang-600 transition-colors"><%= rel.judul %></h3>
                            <p class="text-gray-400 text-xs mt-2 line-clamp-2"><%= stripHtml(rel.deskripsi) %></p>
                        </div>
                        <div class="flex items-center justify-between text-xs text-gray-500 mt-4 pt-4 border-t border-gray-50">
                            <span><i class="fas fa-map-marker-alt text-karang-500 mr-1"></i><%= rel.lokasi %></span>
                            <span><i class="far fa-calendar-alt text-karang-500 mr-1"></i><%= formatDateShort(rel.tanggal) %></span>
                        </div>
                    </div>
                </a>
                <% }) %>
            </div>
        </div>
        <% } %>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const pageUrl = encodeURIComponent(window.location.href);
    const pageTitle = encodeURIComponent("<%= item.judul %>");

    const fbBtn = document.getElementById('share-facebook');
    const twBtn = document.getElementById('share-twitter');
    const waBtn = document.getElementById('share-whatsapp');
    const copyBtn = document.getElementById('share-copy');
    const copyTooltip = document.getElementById('copy-tooltip');

    if (fbBtn) fbBtn.href = `https://www.facebook.com/sharer/sharer.php?u=${pageUrl}`;
    if (twBtn) twBtn.href = `https://twitter.com/intent/tweet?url=${pageUrl}&text=${pageTitle}`;
    if (waBtn) waBtn.href = `https://api.whatsapp.com/send?text=${pageTitle}%20${pageUrl}`;

    if (copyBtn) {
        copyBtn.addEventListener('click', function() {
            navigator.clipboard.writeText(window.location.href).then(function() {
                if (copyTooltip) {
                    copyTooltip.classList.remove('opacity-0');
                    copyTooltip.classList.add('opacity-100');
                    setTimeout(function() {
                        copyTooltip.classList.remove('opacity-100');
                        copyTooltip.classList.add('opacity-0');
                    }, 2000);
                }
            }).catch(function(err) {
                console.error('Gagal menyalin tautan: ', err);
            });
        });
    }
});
</script>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
