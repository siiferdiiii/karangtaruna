<%- include('partials/head') %>
<%- include('partials/navbar') %>

<section class="py-24 bg-gray-50 min-h-screen">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
        <div class="text-center mb-10">
            <span class="inline-block px-4 py-1 bg-karang-100 text-karang-700 rounded-full text-sm font-semibold mb-4">Kegiatan Kami</span>
            <h1 class="text-4xl font-bold text-gray-900">Formulir Pendaftaran</h1>
            <p class="text-gray-600 mt-3">Kegiatan: <strong><%= kegiatan.judul %></strong></p>
            <div class="flex items-center justify-center gap-6 mt-4 text-sm text-gray-500">
                <span><i class="fas fa-map-marker-alt text-karang-500 mr-1"></i><%= kegiatan.lokasi %></span>
                <span><i class="far fa-calendar-alt text-karang-500 mr-1"></i><%= formatDate(kegiatan.tanggal) %></span>
            </div>
        </div>

        <% if (success) { %>
        <div class="bg-green-50 border border-green-200 rounded-2xl p-6 text-center mb-8">
            <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-check text-green-600 text-2xl"></i>
            </div>
            <h2 class="text-xl font-bold text-green-800 mb-2">Pendaftaran Berhasil!</h2>
            <p class="text-green-700">Terima kasih telah mendaftar. Panitia akan menghubungi Anda lebih lanjut.</p>
            <a href="/kegiatan" class="inline-block mt-4 px-6 py-2 bg-karang-500 text-white rounded-full font-semibold hover:bg-karang-600 transition">Kembali ke Kegiatan</a>
        </div>
        <% } else { %>
        <div class="bg-white rounded-2xl shadow-lg p-8">
            <form action="/daftar-kegiatan/<%= kegiatan.id %>" method="POST" class="space-y-5">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Nama Lengkap <span class="text-red-500">*</span></label>
                    <input type="text" name="nama" required class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-karang-400 focus:border-transparent outline-none" placeholder="Nama lengkap Anda">
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Email</label>
                        <input type="email" name="email" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-karang-400 focus:border-transparent outline-none" placeholder="email@contoh.com">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">No. Handphone <span class="text-red-500">*</span></label>
                        <input type="tel" name="no_hp" required class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-karang-400 focus:border-transparent outline-none" placeholder="08xxxxxxxxxx">
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Alamat</label>
                    <input type="text" name="alamat" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-karang-400 focus:border-transparent outline-none" placeholder="Alamat lengkap">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Catatan (opsional)</label>
                    <textarea name="catatan" rows="3" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-karang-400 focus:border-transparent outline-none resize-none" placeholder="Pertanyaan atau catatan tambahan..."></textarea>
                </div>
                <button type="submit" class="w-full py-3 bg-gradient-to-r from-karang-500 to-karang-600 text-white rounded-xl font-semibold hover:shadow-lg hover:scale-105 transition-all flex items-center justify-center gap-2">
                    <i class="fas fa-paper-plane"></i> Daftar Sekarang
                </button>
            </form>
        </div>
        <% } %>
    </div>
</section>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
