<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Karang Taruna Kel. Tanjung</title>
    <meta name="description" content="Media Informasi Resmi Karang Taruna Kelurahan Tanjung, Kabupaten Mempawah - Wadah pengembangan generasi muda Kelurahan Tanjung">
    <meta name="keywords" content="karang taruna, kelurahan tanjung, mempawah, pemuda, kegiatan, berita">
    <meta property="og:title" content="<%= title %> | Karang Taruna Kel. Tanjung">
    <meta property="og:description" content="Media Informasi Resmi Karang Taruna Kelurahan Tanjung, Kabupaten Mempawah">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { poppins: ['Poppins', 'sans-serif'] },
                    colors: {
                        karang: {
                            50: '#fff7ed', 100: '#ffedd5', 200: '#fed7aa', 300: '#fdba74',
                            400: '#fb923c', 500: '#f97316', 600: '#ea580c', 700: '#c2410c',
                            800: '#9a3412', 900: '#7c2d12'
                        },
                        taruna: {
                            50: '#eff6ff', 100: '#dbeafe', 500: '#3b82f6',
                            600: '#2563eb', 700: '#1d4ed8', 800: '#1e40af', 900: '#1e3a8a'
                        }
                    }
                }
            }
        }
    </script>
<% if (typeof s !== 'undefined' && s && s.primary_color) { %>
<style>
:root { --kt-p: <%= s.primary_color %>; }
/* Override Tailwind karang classes with custom primary color */
.bg-karang-500    { background-color: var(--kt-p) !important; }
.bg-karang-600    { background-color: color-mix(in srgb, var(--kt-p) 85%, black) !important; }
.bg-karang-100    { background-color: color-mix(in srgb, var(--kt-p) 15%, white) !important; }
.text-karang-500,
.text-karang-600,
.text-karang-700  { color: var(--kt-p) !important; }
.text-karang-400  { color: color-mix(in srgb, var(--kt-p) 70%, white) !important; }
.text-karang-100  { color: color-mix(in srgb, var(--kt-p) 15%, white) !important; }
.border-karang-500,
.border-karang-600 { border-color: var(--kt-p) !important; }
.hover\:bg-karang-500:hover    { background-color: var(--kt-p) !important; }
.hover\:border-karang-500:hover { border-color: var(--kt-p) !important; }
.hover\:text-karang-600:hover  { color: var(--kt-p) !important; }
.from-karang-500  { --tw-gradient-from: var(--kt-p) !important; }
.to-karang-600    { --tw-gradient-to: color-mix(in srgb, var(--kt-p) 80%, black) !important; }
.via-karang-600   { --tw-gradient-via: var(--kt-p) !important; }
.bg-gradient-to-r.from-karang-500 { background-image: linear-gradient(to right, var(--kt-p), color-mix(in srgb, var(--kt-p) 75%, black)) !important; }
</style>
<% } %>
</head>
<body class="font-poppins text-gray-800 overflow-x-hidden bg-gray-50">
