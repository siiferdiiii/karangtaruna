<%
let cardClass = "polaroid-card relative bg-white flex flex-col items-center text-center transition-all duration-300";
let imgSize = "w-24 h-24";
let roleBadgeColor = "bg-orange-100 text-orange-800";

if (type === 'leader') {
    imgSize = "w-32 h-32";
    roleBadgeColor = "bg-orange-600 text-white";
} else if (type === 'bph') {
    imgSize = "w-24 h-24";
    roleBadgeColor = "bg-blue-100 text-blue-800";
} else {
    imgSize = "w-20 h-20";
    roleBadgeColor = "bg-gray-100 text-gray-800";
}
%>

<div class="<%= cardClass %>" style="width: 200px; padding: 12px; font-family: 'Poppins', sans-serif;">
    <!-- Photo frame -->
    <div class="<%= imgSize %> overflow-hidden border-2 border-gray-800 bg-gray-100 mb-3 shadow-inner relative group flex-shrink-0" style="border-radius: 6px;">
        <img src="<%= member.foto %>" alt="<%= member.nama %>" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500">
        
        <!-- Social Media Overlay -->
        <% if (member.sosmed_instagram || member.sosmed_linkedin) { %>
            <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center gap-3">
                <% if (member.sosmed_instagram) { %>
                    <% 
                    let igHandle = member.sosmed_instagram;
                    if (!igHandle.startsWith('http')) {
                        igHandle = 'https://instagram.com/' + igHandle.replace('@', '');
                    }
                    %>
                    <a href="<%= igHandle %>" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-orange-500 text-white flex items-center justify-center hover:bg-orange-600 transition hover:scale-110">
                        <i class="fab fa-instagram text-xs"></i>
                    </a>
                <% } %>
                <% if (member.sosmed_linkedin) { %>
                    <a href="<%= member.sosmed_linkedin %>" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center hover:bg-blue-700 transition hover:scale-110">
                        <i class="fab fa-linkedin-in text-xs"></i>
                    </a>
                <% } %>
            </div>
        <% } %>
    </div>
    
    <!-- Info -->
    <div class="w-full">
        <h4 class="font-bold text-gray-900 text-xs leading-snug truncate" title="<%= member.nama %>">
            <%= member.nama %>
        </h4>
        <p class="text-[10px] text-gray-500 font-semibold mt-0.5 mb-2 truncate" title="<%= member.jabatan %>">
            <%= member.jabatan %>
        </p>
        <span class="inline-block px-2 py-0.5 rounded-full text-[8px] font-black uppercase tracking-wider <%= roleBadgeColor %>">
            <%= member.divisi === 'BPH' ? 'Pengurus Harian' : member.divisi %>
        </span>
    </div>
</div>
