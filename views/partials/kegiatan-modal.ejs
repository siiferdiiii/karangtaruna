<!-- Modal Detail Kegiatan -->
<div id="kegiatan-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm transition-opacity"></div>
    
    <!-- Modal Content -->
    <div class="relative bg-white rounded-3xl overflow-hidden shadow-2xl max-w-2xl w-full mx-4 z-10 transform scale-95 opacity-0 transition-all duration-300 flex flex-col max-h-[85vh]">
        <!-- Close Button (Sticky/Absolute) -->
        <button id="close-modal-btn" class="absolute top-4 right-4 bg-black/50 hover:bg-black/80 text-white w-10 h-10 rounded-full flex items-center justify-center transition-all z-20 outline-none">
            <i class="fas fa-times text-lg"></i>
        </button>
        
        <!-- Image Header -->
        <div class="relative h-64 sm:h-80 w-full overflow-hidden shrink-0">
            <img id="modal-gambar" src="" alt="" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/35 to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6 z-10">
                <span id="modal-kategori" class="inline-block px-3 py-1 text-white text-xs font-bold rounded-full mb-3 uppercase"></span>
                <h2 id="modal-judul" class="text-2xl sm:text-3xl font-bold text-white leading-tight"></h2>
            </div>
        </div>
        
        <!-- Modal Body (Scrollable) -->
        <div class="p-6 sm:p-8 overflow-y-auto space-y-6 flex-1">
            <!-- Metadata (Location & Date) -->
            <div class="flex flex-wrap gap-6 text-sm text-gray-600 border-b border-gray-100 pb-4">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-karang-100 text-karang-600 flex items-center justify-center shrink-0">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <div>
                        <p class="text-xs text-gray-400 font-medium">Lokasi</p>
                        <p id="modal-lokasi" class="font-semibold text-gray-800"></p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-taruna-100 text-taruna-600 flex items-center justify-center shrink-0">
                        <i class="far fa-calendar-alt"></i>
                    </div>
                    <div>
                        <p class="text-xs text-gray-400 font-medium">Tanggal</p>
                        <p id="modal-tanggal" class="font-semibold text-gray-800"></p>
                    </div>
                </div>
            </div>
            
            <!-- Description -->
            <div>
                <h4 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-2">Deskripsi Kegiatan</h4>
                <div id="modal-deskripsi" class="text-gray-600 leading-relaxed text-sm sm:text-base whitespace-pre-line prose prose-sm max-w-none"></div>
            </div>
        </div>
        
        <!-- Modal Footer -->
        <div class="p-6 border-t border-gray-100 bg-gray-50 flex items-center justify-between gap-4 shrink-0 rounded-b-3xl">
            <button id="close-modal-footer-btn" class="px-6 py-2.5 text-gray-600 hover:text-gray-900 hover:bg-gray-100 rounded-xl font-medium transition-all text-sm">
                Tutup
            </button>
            <a id="modal-daftar-btn" href="" class="px-8 py-2.5 bg-gradient-to-r from-karang-500 to-taruna-600 text-white rounded-xl font-bold hover:shadow-lg hover:scale-105 transition-all text-sm flex items-center gap-2">
                <i class="fas fa-user-plus"></i> Daftar Sekarang
            </a>
            <span id="modal-pendaftaran-tutup" class="px-6 py-2.5 bg-gray-200 text-gray-500 rounded-xl font-semibold text-sm hidden">
                Pendaftaran Ditutup
            </span>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('kegiatan-modal');
    const modalContent = modal ? modal.querySelector('.relative.bg-white') : null;
    const modalGambar = document.getElementById('modal-gambar');
    const modalKategori = document.getElementById('modal-kategori');
    const modalJudul = document.getElementById('modal-judul');
    const modalLokasi = document.getElementById('modal-lokasi');
    const modalTanggal = document.getElementById('modal-tanggal');
    const modalDeskripsi = document.getElementById('modal-deskripsi');
    const modalDaftarBtn = document.getElementById('modal-daftar-btn');
    const modalPendaftaranTutup = document.getElementById('modal-pendaftaran-tutup');
    const closeModalBtn = document.getElementById('close-modal-btn');
    const closeModalFooterBtn = document.getElementById('close-modal-footer-btn');

    if (!modal) return;

    function openModal(data) {
        // Set images & content
        modalGambar.src = data.gambar;
        modalGambar.alt = data.judul;
        modalJudul.textContent = data.judul;
        modalLokasi.textContent = data.lokasi;
        modalTanggal.textContent = data.tanggal;
        
        // Use innerHTML for deskripsi because it may contain HTML paragraphs or formatting
        modalDeskripsi.innerHTML = data.deskripsi;

        // Category formatting
        modalKategori.textContent = data.kategori;
        modalKategori.className = 'inline-block px-3 py-1 text-white text-xs font-bold rounded-full mb-3 uppercase';
        
        const cat = data.kategori.toLowerCase();
        if (cat === 'sosial') {
            modalKategori.classList.add('bg-karang-500');
        } else if (cat === 'lingkungan') {
            modalKategori.classList.add('bg-green-500');
        } else if (cat === 'kreativitas') {
            modalKategori.classList.add('bg-purple-500');
        } else {
            modalKategori.classList.add('bg-taruna-500');
        }

        // Pendaftaran button
        const isOpen = data.buka === 'true' || data.buka === true;
        if (isOpen) {
            modalDaftarBtn.href = '/daftar-kegiatan/' + data.id;
            modalDaftarBtn.classList.remove('hidden');
            modalPendaftaranTutup.classList.add('hidden');
        } else {
            modalDaftarBtn.classList.add('hidden');
            modalPendaftaranTutup.classList.remove('hidden');
        }

        // Show modal with animation
        modal.classList.remove('hidden');
        // Small delay to trigger transition
        setTimeout(() => {
            modalContent.classList.remove('scale-95', 'opacity-0');
            modalContent.classList.add('scale-100', 'opacity-100');
        }, 10);
        
        // Prevent background scrolling
        document.body.classList.add('overflow-hidden');
    }

    function closeModal() {
        modalContent.classList.remove('scale-100', 'opacity-100');
        modalContent.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
            modal.classList.add('hidden');
            // Re-enable background scrolling
            document.body.classList.remove('overflow-hidden');
        }, 300);
    }

    // Attach click listeners to all activity cards
    document.addEventListener('click', function(e) {
        const card = e.target.closest('.activity-card');
        if (card) {
            const data = {
                id: card.getAttribute('data-id'),
                judul: card.getAttribute('data-judul'),
                kategori: card.getAttribute('data-kategori'),
                lokasi: card.getAttribute('data-lokasi'),
                tanggal: card.getAttribute('data-tanggal'),
                gambar: card.getAttribute('data-gambar'),
                buka: card.getAttribute('data-buka'),
                deskripsi: card.querySelector('.hidden-deskripsi').innerHTML
            };
            openModal(data);
        }
    });

    // Close on click
    if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
    if (closeModalFooterBtn) closeModalFooterBtn.addEventListener('click', closeModal);

    // Close on backdrop click
    modal.querySelector('.absolute.inset-0.bg-black\\/60').addEventListener('click', closeModal);

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
            closeModal();
        }
    });
});
</script>
