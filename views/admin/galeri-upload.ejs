<%- include('partials/header', { activePage: 'galeri', extraHead: '' }) %>

<div class="page-header">
    <div>
        <h1 class="page-title">Upload Gambar Galeri</h1>
        <p class="page-sub">Tambahkan gambar ke galeri website</p>
    </div>
    <a href="/admin/galeri" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Kembali</a>
</div>

<div class="form-grid">
    <div class="form-main">
        <form action="/admin/galeri/upload" method="POST" enctype="multipart/form-data" id="galeriForm">
            <div class="section-card">
                <div class="form-group">
                    <label class="form-label">Judul Gambar <span class="required">*</span></label>
                    <input type="text" name="judul" class="form-input" placeholder="Contoh: Gotong Royong RT 03" required>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Kategori</label>
                        <select name="kategori" class="form-input form-select">
                            <option value="umum">Umum</option>
                            <option value="kegiatan">Kegiatan</option>
                            <option value="dokumentasi">Dokumentasi</option>
                            <option value="prestasi">Prestasi</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Deskripsi (opsional)</label>
                    <textarea name="deskripsi" class="form-input form-textarea" rows="2" placeholder="Keterangan singkat tentang gambar..."></textarea>
                </div>
            </div>

            <div class="section-card">
                <h3 class="card-subtitle">Pilih Gambar <span class="required">*</span></h3>
                <p class="help-text" style="margin-bottom:12px">Bisa pilih lebih dari satu gambar sekaligus</p>
                
                <!-- Preview area -->
                <div id="previewGrid" class="galeri-grid" style="margin-bottom:16px"></div>

                <label class="upload-area" for="gambarInput" id="uploadLabel">
                    <i class="fas fa-cloud-upload-alt"></i>
                    <span>Klik atau drag gambar ke sini</span>
                    <small>JPG, PNG, WebP — Maks. 5MB per file</small>
                    <input type="file" name="gambar" id="gambarInput" accept="image/*" multiple style="display:none">
                </label>
            </div>

            <div class="form-actions" style="margin-top:16px">
                <button type="submit" class="btn btn-primary btn-full">
                    <i class="fas fa-cloud-upload-alt"></i> Upload ke Galeri
                </button>
                <a href="/admin/galeri" class="btn btn-ghost btn-full">Batal</a>
            </div>
        </form>
    </div>

    <div class="form-sidebar">
        <div class="section-card">
            <h3 class="card-subtitle"><i class="fas fa-info-circle"></i> Panduan Upload</h3>
            <ul style="font-size:13px;color:var(--text-muted);line-height:2;padding-left:16px">
                <li>Format: JPG, PNG, WebP, GIF</li>
                <li>Ukuran max: 5MB per file</li>
                <li>Bisa upload banyak gambar sekaligus</li>
                <li>Gambar akan tampil di halaman Galeri publik</li>
                <li>Resolusi rekomendasi: min 800×600px</li>
            </ul>
        </div>
    </div>
</div>

<%- include('partials/footer', { extraScript: '' }) %>
<script>
document.getElementById('gambarInput').addEventListener('change', function() {
    const preview = document.getElementById('previewGrid');
    preview.innerHTML = '';
    Array.from(this.files).forEach(file => {
        const reader = new FileReader();
        reader.onload = e => {
            const card = document.createElement('div');
            card.className = 'galeri-card';
            card.style.position = 'relative';
            card.innerHTML = '<div class="galeri-img-wrap"><img src="' + e.target.result + '" class="galeri-img" style="height:140px"></div><div class="galeri-info"><div class="galeri-title" style="font-size:11px">' + file.name + '</div></div>';
            preview.appendChild(card);
        };
        reader.readAsDataURL(file);
    });
    if (this.files.length > 0) {
        document.getElementById('uploadLabel').style.borderColor = '#22c55e';
    }
});
</script>
