<%- include('partials/header', { activePage: 'pengurus', extraHead: '' }) %>

<div class="page-header">
    <div>
        <h1 class="page-title">Kelola Pengurus</h1>
        <p class="page-sub">Kelola struktur organisasi dan pengurus Karang Taruna Kelurahan Tanjung</p>
    </div>
</div>

<div class="form-grid">
    <!-- Kolom Kiri: Form Tambah Pengurus -->
    <div class="form-main">
        <div class="section-card">
            <h3 class="card-subtitle"><i class="fas fa-user-plus"></i> Tambah Pengurus Baru</h3>
            <form action="/admin/pengurus/tambah" method="POST" enctype="multipart/form-data" id="pengurusForm">
                <div class="form-group">
                    <label class="form-label" for="namaInput">Nama Lengkap <span class="required">*</span></label>
                    <input type="text" name="nama" id="namaInput" class="form-input" placeholder="Masukkan nama lengkap pengurus" required>
                </div>
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group">
                        <label class="form-label" for="jabatanInput">Jabatan <span class="required">*</span></label>
                        <input type="text" name="jabatan" id="jabatanInput" class="form-input" placeholder="Contoh: Ketua, Sekretaris, Koordinator" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="divisiInput">Divisi / Bidang <span class="required">*</span></label>
                        <select name="divisi" id="divisiInput" class="form-input" required>
                            <option value="BPH">Badan Pengurus Harian (BPH)</option>
                            <option value="Keagamaan">Bidang Kerohanian & Keagamaan</option>
                            <option value="Olahraga">Bidang Olahraga & Rekreasi</option>
                            <option value="Humas">Bidang Humas & Kemitraan</option>
                            <option value="Lingkungan">Bidang Kebersihan & Lingkungan</option>
                            <option value="Seni">Bidang Seni & Budaya</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="urutanInput">Urutan Posisi / Hirarki <span class="required">*</span></label>
                    <input type="number" name="urutan" id="urutanInput" class="form-input" placeholder="Semakin kecil nilainya, posisi semakin di atas" value="10" required>
                    <small class="help-text">Ketua = 1, Wakil = 2, Sekretaris = 3, Bendahara = 4, Koordinator Bidang = 10, Anggota Bidang = 20.</small>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group">
                        <label class="form-label" for="instagramInput">Instagram <small>(opsional)</small></label>
                        <input type="text" name="sosmed_instagram" id="instagramInput" class="form-input" placeholder="@username_instagram">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="linkedinInput">LinkedIn <small>(opsional)</small></label>
                        <input type="url" name="sosmed_linkedin" id="linkedinInput" class="form-input" placeholder="https://linkedin.com/in/username">
                    </div>
                </div>
                
                <div class="form-group">
                    <label class="form-label">Foto Profil <span class="required">*</span></label>
                    <div id="previewBox" class="hidden" style="margin-bottom: 12px; text-align: center; background: #f8fafc; border: 1.5px solid var(--border); border-radius: 8px; padding: 16px;">
                        <img id="imgPreview" src="" alt="Preview Foto" style="height: 120px; width: 120px; border-radius: 50%; object-fit: cover; margin: 0 auto; border: 2px solid var(--primary);">
                    </div>
                    <label class="upload-area" for="fotoInput">
                        <i class="fas fa-cloud-upload-alt"></i>
                        <span>Klik atau drag foto profil ke sini</span>
                        <small>Format Kotak/Square 1:1 Sangat Disarankan (Maks. 500x500px)</small>
                        <input type="file" name="foto" id="fotoInput" accept="image/*" style="display:none" required>
                    </label>
                </div>

                <div style="margin-top:24px;">
                    <button type="submit" class="btn btn-primary btn-full">
                        <i class="fas fa-user-plus"></i> Simpan Pengurus
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Kolom Kanan: Daftar Pengurus Saat Ini -->
    <div class="form-sidebar">
        <div class="section-card" style="min-height: 480px;">
            <h3 class="card-subtitle"><i class="fas fa-sitemap"></i> Pengurus Terdaftar (<%= pengurus.length %>)</h3>
            
            <% if (pengurus.length === 0) { %>
            <div class="empty-state-full" style="padding: 40px 0;">
                <i class="fas fa-users-slash" style="font-size:36px; margin-bottom:8px;"></i>
                <p>Belum ada pengurus terdaftar.</p>
            </div>
            <% } else { %>
            <div style="display: grid; grid-template-columns: 1fr; gap: 12px; max-height: 600px; overflow-y: auto; padding-right: 4px;">
                <% pengurus.forEach(item => { %>
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px; border: 1px solid var(--border); border-radius: var(--radius); background: #ffffff; transition: box-shadow 0.2s;" class="hover:shadow-sm">
                    <div style="display: flex; align-items: center; gap: 14px; min-width: 0;">
                        <div style="width: 48px; height: 48px; border-radius: 50%; overflow: hidden; border: 1px solid #e2e8f0; background: #f8fafc; display: flex; align-items: center; justify-content: center;" class="shrink-0">
                            <img src="<%= item.foto %>" alt="<%= item.nama %>" style="width: 100%; height: 100%; object-fit: cover;">
                        </div>
                        <div style="min-width: 0;">
                            <strong style="display: block; font-size: 13px; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= item.nama %></strong>
                            <span style="font-size: 11px; color: var(--primary); font-weight: 500; display: block;" class="truncate"><%= item.jabatan %></span>
                            <span style="font-size: 10px; color: var(--text-muted); display: block;" class="truncate">Divisi: <%= item.divisi %> (Urutan: <%= item.urutan %>)</span>
                        </div>
                    </div>
                    <div style="display: flex; gap: 6px; flex-shrink:0;">
                        <a href="/admin/pengurus/edit/<%= item.id %>" class="btn-icon" title="Edit Pengurus" style="width: 28px; height: 28px; background: #f1f5f9; color: var(--text); border-radius: 6px; display: flex; align-items: center; justify-content: center; text-decoration: none;">
                            <i class="fas fa-edit" style="font-size: 11px;"></i>
                        </a>
                        <form action="/admin/pengurus/hapus/<%= item.id %>" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus pengurus ini?');" style="margin: 0;">
                            <button type="submit" class="btn-icon btn-delete" title="Hapus Pengurus" style="width: 28px; height: 28px;">
                                <i class="fas fa-trash" style="font-size: 11px;"></i>
                            </button>
                        </form>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('partials/footer', { extraScript: '' }) %>

<script>
    // Live Image Preview
    document.getElementById('fotoInput').addEventListener('change', function() {
        var file = this.files[0];
        if (file) {
            var reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('imgPreview').src = e.target.result;
                document.getElementById('previewBox').classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        }
    });
</script>
