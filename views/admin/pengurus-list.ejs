<%- include('partials/header', { activePage: 'pengurus', extraHead: '' }) %>

<div class="page-header">
    <div>
        <h1 class="page-title">Kelola Pengurus & Struktur</h1>
        <p class="page-sub">Kelola bagan struktur organisasi dan database pengurus Karang Taruna Kelurahan Tanjung</p>
    </div>
</div>

<!-- Alert info premium -->
<div style="background: linear-gradient(135deg, #fff3e6 0%, #ffe8cc 100%); border-left: 5px solid #e5792a; padding: 1.25rem; border-radius: 12px; margin-bottom: 2rem; display: flex; gap: 1rem; align-items: flex-start; box-shadow: 0 4px 15px rgba(229,121,42,0.08);">
    <div style="background: #e5792a; color: #fff; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 16px; box-shadow: 0 4px 8px rgba(229,121,42,0.3);">
        <i class="fas fa-info-circle"></i>
    </div>
    <div style="flex: 1;">
        <h4 style="font-weight: 700; color: #7c2d12; margin-top: 0.15rem; font-size: 15px; margin-bottom: 0.25rem;">Informasi: Format Tampilan Halaman Publik</h4>
        <p style="font-size: 13px; color: #9a3412; line-height: 1.5; margin: 0;">
            Halaman publik <strong>Struktur Organisasi</strong> saat ini telah didesain ulang dengan konsep visual premium ala <strong>umkm.go.id</strong>. Halaman tersebut menampilkan <strong>satu gambar bagan tunggal</strong> yang di-upload di bawah ini.
        </p>
        <p style="font-size: 12px; color: #c2410c; margin-top: 0.5rem; font-weight: 600;">
            * Database Pengurus Terdaftar (di kolom kanan/bawah) tetap disimpan dengan aman di database. Jika nanti Anda ingin beralih kembali ke tampilan kartu individu, data Anda tidak akan hilang.
        </p>
    </div>
</div>

<!-- Form Upload Bagan Struktur -->
<div class="section-card" style="margin-bottom: 2rem;">
    <h3 class="card-subtitle" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem;">
        <span><i class="fas fa-sitemap" style="color: #e5792a;"></i> Pengaturan Bagan & Header Struktur Halaman Publik</span>
        <span style="font-size: 11px; padding: 4px 10px; background: #e0f2fe; color: #0369a1; border-radius: 999px; font-weight: 700;">TAMPILAN AKTIF PUBLIK</span>
    </h3>
    
    <form action="/admin/pengurus/struktur-bagan" method="POST" enctype="multipart/form-data">
        <div style="display: grid; grid-template-columns: 1fr; gap: 24px;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                <!-- Bagan Struktur Gambar -->
                <div>
                    <h4 style="font-size: 13px; font-weight: 700; color: var(--text); margin-bottom: 12px;"><i class="fas fa-project-diagram" style="color:#e5792a;margin-right:4px;"></i> 1. Gambar Bagan Struktur</h4>
                    <div style="margin-bottom: 12px;">
                        <% if (settings.struktur_image) { %>
                        <img id="baganPreview" src="<%= settings.struktur_image %>" alt="Bagan Struktur" style="width: 100%; border-radius: 8px; object-fit: cover; max-height: 140px; border: 1px solid var(--border);">
                        <% } else { %>
                        <div id="baganPreviewPlaceholder" style="width: 100%; height: 120px; border-radius: 8px; background: #f8fafc; border: 2px dashed #e2e8f0; display: flex; align-items: center; justify-content: center; color: #64748b; font-size: 12px; flex-direction:column; gap:6px;">
                            <i class="fas fa-sitemap" style="font-size:24px;color:#cbd5e1;"></i>
                            <span>Belum ada gambar bagan</span>
                        </div>
                        <% } %>
                    </div>
                    <label class="upload-area" for="baganFileInput" style="padding: 12px; min-height: 60px;">
                        <i class="fas fa-cloud-upload-alt" style="font-size: 16px; margin-bottom: 2px;"></i>
                        <span style="font-size: 11px; font-weight:600;">Pilih Gambar Bagan Baru</span>
                        <input type="file" name="struktur_image_file" id="baganFileInput" accept="image/*" style="display:none">
                    </label>
                    <div class="form-group" style="margin-top: 12px;">
                        <label class="form-label" style="font-size: 11px;">Atau URL Gambar Bagan</label>
                        <input type="url" name="struktur_image" id="baganUrlInput" class="form-input" value="<%= settings.struktur_image || '' %>" placeholder="https://..." style="padding: 8px 12px; font-size: 12px;">
                    </div>
                </div>

                <!-- Header Latar Gambar -->
                <div>
                    <h4 style="font-size: 13px; font-weight: 700; color: var(--text); margin-bottom: 12px;"><i class="fas fa-image" style="color:#e5792a;margin-right:4px;"></i> 2. Gambar Latar Header Halaman</h4>
                    <div style="margin-bottom: 12px;">
                        <% if (settings.struktur_hero_image) { %>
                        <img id="headerPreview" src="<%= settings.struktur_hero_image %>" alt="Header Latar" style="width: 100%; border-radius: 8px; object-fit: cover; max-height: 140px; border: 1px solid var(--border);">
                        <% } else { %>
                        <div id="headerPreviewPlaceholder" style="width: 100%; height: 120px; border-radius: 8px; background: #1e293b; display: flex; align-items: center; justify-content: center; color: #cbd5e1; font-size: 12px; flex-direction:column; gap:6px;">
                            <i class="fas fa-image" style="font-size:24px;color:#475569;"></i>
                            <span style="color:#94a3b8;">Menggunakan latar default (dark)</span>
                        </div>
                        <% } %>
                    </div>
                    <label class="upload-area" for="headerFileInput" style="padding: 12px; min-height: 60px; background: #fafafa;">
                        <i class="fas fa-cloud-upload-alt" style="font-size: 16px; margin-bottom: 2px; color: #64748b;"></i>
                        <span style="font-size: 11px; color: #475569; font-weight:600;">Pilih Gambar Latar Baru</span>
                        <input type="file" name="struktur_hero_image_file" id="headerFileInput" accept="image/*" style="display:none">
                    </label>
                    <div class="form-group" style="margin-top: 12px;">
                        <label class="form-label" style="font-size: 11px;">Atau URL Gambar Latar</label>
                        <input type="url" name="struktur_hero_image" id="headerUrlInput" class="form-input" value="<%= settings.struktur_hero_image || '' %>" placeholder="https://..." style="padding: 8px 12px; font-size: 12px;">
                    </div>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1.5fr; gap: 16px; border-top: 1px solid #f1f5f9; padding-top: 1.25rem; margin-top:0.5rem;">
                <div class="form-group">
                    <label class="form-label" style="font-size: 12px;">Judul Halaman Struktur (Publik)</label>
                    <input type="text" name="struktur_judul" class="form-input" value="<%= settings.struktur_judul || 'Struktur Organisasi Karang Taruna Muda Insan Cita' %>" style="padding: 8px 12px; font-size: 12px;">
                </div>
                <div class="form-group">
                    <label class="form-label" style="font-size: 12px;">Deskripsi Singkat Halaman</label>
                    <input type="text" name="struktur_deskripsi" class="form-input" value="<%= settings.struktur_deskripsi || '' %>" placeholder="Deskripsi opsional di bawah judul..." style="padding: 8px 12px; font-size: 12px;">
                </div>
            </div>
        </div>

        <div style="margin-top: 1.5rem; text-align: right; border-top: 1px solid #f1f5f9; padding-top: 1rem;">
            <button type="submit" class="btn btn-primary" style="padding: 10px 24px; font-size: 13px; font-weight: 700; border-radius: 8px; box-shadow: 0 4px 10px rgba(229,121,42,0.15);">
                <i class="fas fa-save" style="margin-right: 6px;"></i> Simpan Pengaturan Bagan & Header
            </button>
        </div>
    </form>
</div>

<div class="form-grid">
    <!-- Kolom Kiri: Form Tambah Pengurus -->
    <div class="form-main">
        <div class="section-card">
            <h3 class="card-subtitle"><i class="fas fa-user-plus"></i> Tambah Pengurus Baru</h3>
            <form action="/admin/pengurus/tambah" method="POST" enctype="multipart/form-data" id="pengurusForm">
                <div class="form-group">
                    <label class="form-label" for="namaInput">Nama Lengkap <span class="required">*</span></label>
                    <input type="text" name="nama" id="namaInput" class="form-input" placeholder="Masukkan nama lengkap pengurus" required>
                </div>
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group">
                        <label class="form-label" for="jabatanInput">Jabatan <span class="required">*</span></label>
                        <input type="text" name="jabatan" id="jabatanInput" class="form-input" placeholder="Contoh: Ketua, Sekretaris, Koordinator" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="divisiInput">Divisi / Bidang <span class="required">*</span></label>
                        <select name="divisi" id="divisiInput" class="form-input" required>
                            <option value="BPH">Badan Pengurus Harian (BPH)</option>
                            <option value="Keagamaan">Bidang Kerohanian & Keagamaan</option>
                            <option value="Olahraga">Bidang Olahraga & Rekreasi</option>
                            <option value="Humas">Bidang Humas & Kemitraan</option>
                            <option value="Lingkungan">Bidang Kebersihan & Lingkungan</option>
                            <option value="Seni">Bidang Seni & Budaya</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="urutanInput">Urutan Posisi / Hirarki <span class="required">*</span></label>
                    <input type="number" name="urutan" id="urutanInput" class="form-input" placeholder="Semakin kecil nilainya, posisi semakin di atas" value="10" required>
                    <small class="help-text">Ketua = 1, Wakil = 2, Sekretaris = 3, Bendahara = 4, Koordinator Bidang = 10, Anggota Bidang = 20.</small>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group">
                        <label class="form-label" for="instagramInput">Instagram <small>(opsional)</small></label>
                        <input type="text" name="sosmed_instagram" id="instagramInput" class="form-input" placeholder="@username_instagram">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="linkedinInput">LinkedIn <small>(opsional)</small></label>
                        <input type="url" name="sosmed_linkedin" id="linkedinInput" class="form-input" placeholder="https://linkedin.com/in/username">
                    </div>
                </div>
                
                <div class="form-group">
                    <label class="form-label">Foto Profil <span class="required">*</span></label>
                    <div id="previewBox" class="hidden" style="margin-bottom: 12px; text-align: center; background: #f8fafc; border: 1.5px solid var(--border); border-radius: 8px; padding: 16px;">
                        <img id="imgPreview" src="" alt="Preview Foto" style="height: 120px; width: 120px; border-radius: 50%; object-fit: cover; margin: 0 auto; border: 2px solid var(--primary);">
                    </div>
                    <label class="upload-area" for="fotoInput">
                        <i class="fas fa-cloud-upload-alt"></i>
                        <span>Klik atau drag foto profil ke sini</span>
                        <small>Format Kotak/Square 1:1 Sangat Disarankan (Maks. 500x500px)</small>
                        <input type="file" name="foto" id="fotoInput" accept="image/*" style="display:none" required>
                    </label>
                </div>

                <div style="margin-top:24px;">
                    <button type="submit" class="btn btn-primary btn-full">
                        <i class="fas fa-user-plus"></i> Simpan Pengurus
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Kolom Kanan: Daftar Pengurus Saat Ini -->
    <div class="form-sidebar">
        <div class="section-card" style="min-height: 480px;">
            <h3 class="card-subtitle"><i class="fas fa-sitemap"></i> Pengurus Terdaftar (<%= pengurus.length %>)</h3>
            
            <% if (pengurus.length === 0) { %>
            <div class="empty-state-full" style="padding: 40px 0;">
                <i class="fas fa-users-slash" style="font-size:36px; margin-bottom:8px;"></i>
                <p>Belum ada pengurus terdaftar.</p>
            </div>
            <% } else { %>
            <div style="display: grid; grid-template-columns: 1fr; gap: 12px; max-height: 600px; overflow-y: auto; padding-right: 4px;">
                <% pengurus.forEach(item => { %>
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px; border: 1px solid var(--border); border-radius: var(--radius); background: #ffffff; transition: box-shadow 0.2s;" class="hover:shadow-sm">
                    <div style="display: flex; align-items: center; gap: 14px; min-width: 0;">
                        <div style="width: 48px; height: 48px; border-radius: 50%; overflow: hidden; border: 1px solid #e2e8f0; background: #f8fafc; display: flex; align-items: center; justify-content: center;" class="shrink-0">
                            <img src="<%= item.foto %>" alt="<%= item.nama %>" style="width: 100%; height: 100%; object-fit: cover;">
                        </div>
                        <div style="min-width: 0;">
                            <strong style="display: block; font-size: 13px; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= item.nama %></strong>
                            <span style="font-size: 11px; color: var(--primary); font-weight: 500; display: block;" class="truncate"><%= item.jabatan %></span>
                            <span style="font-size: 10px; color: var(--text-muted); display: block;" class="truncate">Divisi: <%= item.divisi %> (Urutan: <%= item.urutan %>)</span>
                        </div>
                    </div>
                    <div style="display: flex; gap: 6px; flex-shrink:0;">
                        <a href="/admin/pengurus/edit/<%= item.id %>" class="btn-icon" title="Edit Pengurus" style="width: 28px; height: 28px; background: #f1f5f9; color: var(--text); border-radius: 6px; display: flex; align-items: center; justify-content: center; text-decoration: none;">
                            <i class="fas fa-edit" style="font-size: 11px;"></i>
                        </a>
                        <form action="/admin/pengurus/hapus/<%= item.id %>" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus pengurus ini?');" style="margin: 0;">
                            <button type="submit" class="btn-icon btn-delete" title="Hapus Pengurus" style="width: 28px; height: 28px;">
                                <i class="fas fa-trash" style="font-size: 11px;"></i>
                            </button>
                        </form>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('partials/footer', { extraScript: '' }) %>

<script>
    // Live Image Preview for Foto Profil
    document.getElementById('fotoInput').addEventListener('change', function() {
        var file = this.files[0];
        if (file) {
            var reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('imgPreview').src = e.target.result;
                document.getElementById('previewBox').classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        }
    });

    // Live preview helper for bagan
    document.getElementById('baganFileInput').addEventListener('change', function() {
        var file = this.files[0];
        if (file) {
            var reader = new FileReader();
            reader.onload = function(e) {
                var previewImg = document.getElementById('baganPreview');
                if (previewImg) {
                    previewImg.src = e.target.result;
                } else {
                    var placeholder = document.getElementById('baganPreviewPlaceholder');
                    if (placeholder) {
                        var img = document.createElement('img');
                        img.id = 'baganPreview';
                        img.src = e.target.result;
                        img.style = 'width: 100%; border-radius: 8px; object-fit: cover; max-height: 140px; border: 1px solid var(--border);';
                        placeholder.parentNode.replaceChild(img, placeholder);
                    }
                }
                var urlInput = document.getElementById('baganUrlInput');
                if (urlInput) urlInput.value = '';
            };
            reader.readAsDataURL(file);
        }
    });

    // Live preview helper for header
    document.getElementById('headerFileInput').addEventListener('change', function() {
        var file = this.files[0];
        if (file) {
            var reader = new FileReader();
            reader.onload = function(e) {
                var previewImg = document.getElementById('headerPreview');
                if (previewImg) {
                    previewImg.src = e.target.result;
                } else {
                    var placeholder = document.getElementById('headerPreviewPlaceholder');
                    if (placeholder) {
                        var img = document.createElement('img');
                        img.id = 'headerPreview';
                        img.src = e.target.result;
                        img.style = 'width: 100%; border-radius: 8px; object-fit: cover; max-height: 140px; border: 1px solid var(--border);';
                        placeholder.parentNode.replaceChild(img, placeholder);
                    }
                }
                var urlInput = document.getElementById('headerUrlInput');
                if (urlInput) urlInput.value = '';
            };
            reader.readAsDataURL(file);
        }
    });
</script>
