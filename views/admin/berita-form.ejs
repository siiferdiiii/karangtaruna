<% var isEdit = item !== null; %>
<%- include('partials/header', { activePage: 'berita', extraHead: '<link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet"><link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" rel="stylesheet">' }) %>
<style>
.ql-snow .ql-picker.ql-font .ql-picker-label::before,
.ql-snow .ql-picker.ql-font .ql-picker-item::before { content: 'Default'; }
.ql-snow .ql-picker.ql-font .ql-picker-label[data-value=arial]::before,
.ql-snow .ql-picker.ql-font .ql-picker-item[data-value=arial]::before { content: 'Arial'; font-family: Arial; }
.ql-snow .ql-picker.ql-font .ql-picker-label[data-value=timesnewroman]::before,
.ql-snow .ql-picker.ql-font .ql-picker-item[data-value=timesnewroman]::before { content: 'Times New Roman'; font-family: 'Times New Roman'; }
.ql-snow .ql-picker.ql-font .ql-picker-label[data-value=georgia]::before,
.ql-snow .ql-picker.ql-font .ql-picker-item[data-value=georgia]::before { content: 'Georgia'; font-family: Georgia; }
.ql-snow .ql-picker.ql-font .ql-picker-label[data-value=couriernew]::before,
.ql-snow .ql-picker.ql-font .ql-picker-item[data-value=couriernew]::before { content: 'Courier New'; font-family: 'Courier New'; }
.ql-snow .ql-picker.ql-font .ql-picker-label[data-value=verdana]::before,
.ql-snow .ql-picker.ql-font .ql-picker-item[data-value=verdana]::before { content: 'Verdana'; font-family: Verdana; }
.ql-snow .ql-picker.ql-font .ql-picker-label[data-value=tahoma]::before,
.ql-snow .ql-picker.ql-font .ql-picker-item[data-value=tahoma]::before { content: 'Tahoma'; font-family: Tahoma; }
.ql-font-arial { font-family: Arial, Helvetica, sans-serif; }
.ql-font-timesnewroman { font-family: 'Times New Roman', Times, serif; }
.ql-font-georgia { font-family: Georgia, 'Times New Roman', serif; }
.ql-font-couriernew { font-family: 'Courier New', Courier, monospace; }
.ql-font-verdana { font-family: Verdana, Geneva, sans-serif; }
.ql-font-tahoma { font-family: Tahoma, Geneva, sans-serif; }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title"><%= isEdit ? 'Edit Berita' : 'Tulis Berita Baru' %></h1>
        <p class="page-sub"><% if (isEdit) { %>Mengedit: <strong><%= item.judul %></strong><% } else { %>Isi form di bawah untuk menambah berita baru<% } %></p>
    </div>
    <a href="/admin/berita" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Kembali</a>
</div>

<form action="/admin/berita/<%= isEdit ? 'edit/' + item.id : 'tambah' %>" method="POST" enctype="multipart/form-data" class="form-page" id="beritaForm">
    <div class="form-grid">
        <!-- Kolom Kiri -->
        <div class="form-main">
            <div class="section-card">
                <div class="form-group">
                    <label class="form-label" for="judulInput">Judul Berita <span class="required">*</span></label>
                    <input type="text" name="judul" id="judulInput" class="form-input" value="<%= isEdit ? item.judul : '' %>" placeholder="Masukkan judul berita..." required>
                </div>
                <div class="form-group">
                    <label class="form-label" for="slugInput">Slug URL <span class="required">*</span></label>
                    <div class="input-prefix-wrap">
                        <span class="input-prefix">/berita/</span>
                        <input type="text" name="slug" id="slugInput" class="form-input" value="<%= isEdit ? item.slug : '' %>" placeholder="judul-berita-otomatis" required>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Ringkasan <span class="required">*</span></label>
                    <textarea name="ringkasan" class="form-input form-textarea" rows="3" placeholder="Ringkasan singkat berita..." required><%= isEdit ? item.ringkasan : '' %></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label">Konten Lengkap <span class="required">*</span></label>
                    <div id="quill-editor" style="min-height:320px;"></div>
                    <input type="hidden" name="konten" id="kontenInput">
                </div>
            </div>
        </div>

        <!-- Kolom Kanan -->
        <div class="form-sidebar">
            <div class="section-card">
                <h3 class="card-subtitle">Pengaturan</h3>
                <div class="form-group">
                    <label class="form-label">Kategori <span class="required">*</span></label>
                    <select name="kategori" class="form-input form-select" required>
                        <% ['Edukasi','Lingkungan','Sosial','Kreativitas'].forEach(function(kat) { %>
                        <option value="<%= kat %>" <%= isEdit && item.kategori === kat ? 'selected' : '' %>><%= kat %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Tanggal Rilis <span class="required">*</span></label>
                    <% 
                        var dateVal = '';
                        if (isEdit && item.tanggal) {
                            dateVal = new Date(item.tanggal).toISOString().split('T')[0];
                        } else {
                            dateVal = new Date().toISOString().split('T')[0];
                        }
                    %>
                    <input type="date" name="tanggal" class="form-input" value="<%= dateVal %>" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Penulis</label>
                    <input type="text" name="penulis" class="form-input" value="<%= isEdit ? item.penulis : 'Admin' %>" placeholder="Nama penulis">
                </div>
                <div class="form-group">
                    <label class="form-label">Tags <small>(pisah koma)</small></label>
                    <input type="text" name="tag" class="form-input" value="<%= isEdit && item.tag ? item.tag.join(', ') : '' %>" placeholder="pemuda, sosial, kegiatan">
                </div>
            </div>

            <div class="section-card">
                <h3 class="card-subtitle">Gambar Utama</h3>

                <!-- Hidden input penampung hasil crop (base64) -->
                <input type="hidden" name="gambar_crop" id="gambarCropInput">

                <!-- Badge wajib crop -->
                <% if (!isEdit || !item.gambar) { %>
                <div id="cropRequiredBadge" class="crop-required-badge">
                    <i class="fas fa-crop-alt"></i> Wajib pilih &amp; crop gambar sebelum menyimpan
                </div>
                <% } %>

                <!-- Preview hasil crop -->
                <div id="previewBox" class="<%= (isEdit && item.gambar) ? '' : 'hidden' %>">
                    <img id="imgPreview" src="<%= (isEdit && item.gambar) ? item.gambar : '' %>" alt="Preview" class="img-preview">
                    <button type="button" class="crop-reopen-btn" id="cropReopenBtn">
                        <i class="fas fa-crop-alt"></i> Crop Ulang
                    </button>
                </div>

                <!-- Upload area -->
                <label class="upload-area" for="gambarInput" id="uploadAreaLabel">
                    <i class="fas fa-cloud-upload-alt"></i>
                    <span>Klik atau drag gambar ke sini</span>
                    <small>JPG, PNG, WebP — Maks. 5MB &bull; Rasio 16:9</small>
                    <input type="file" id="gambarInput" accept="image/*" style="display:none">
                </label>

                <style>
                .crop-required-badge {
                    background: rgba(234,179,8,0.12);
                    border: 1px solid rgba(234,179,8,0.3);
                    color: #fbbf24;
                    border-radius: 8px;
                    padding: 0.5rem 0.75rem;
                    font-size: 0.78rem;
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                    margin-bottom: 0.75rem;
                }
                .img-preview { width:100%; border-radius:8px; display:block; }
                #previewBox { position:relative; margin-bottom:0.75rem; }
                .crop-reopen-btn {
                    position: absolute;
                    bottom: 8px; right: 8px;
                    background: rgba(0,0,0,0.65);
                    color: #fff;
                    border: none;
                    border-radius: 6px;
                    padding: 0.35rem 0.75rem;
                    font-size: 0.75rem;
                    cursor: pointer;
                    display: flex;
                    align-items: center;
                    gap: 0.4rem;
                    transition: background 0.2s;
                }
                .crop-reopen-btn:hover { background: rgba(99,102,241,0.8); }
                </style>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-full">
                    <i class="fas fa-save"></i> <%= isEdit ? 'Simpan Perubahan' : 'Publikasikan Berita' %>
                </button>
                <a href="/admin/berita" class="btn btn-ghost btn-full">Batal</a>
            </div>
        </div>
    </div>
</form>

<!-- Quill Editor -->
<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<script>
    const Font = Quill.import('formats/font');
    Font.whitelist = ['arial', 'timesnewroman', 'georgia', 'couriernew', 'verdana', 'tahoma'];
    Quill.register(Font, true);

    var quill = new Quill('#quill-editor', {
        theme: 'snow',
        placeholder: 'Tulis konten berita di sini...',
        modules: {
            toolbar: [
                [{ font: ['', 'arial', 'timesnewroman', 'georgia', 'couriernew', 'verdana', 'tahoma'] }],
                [{ header: [1,2,3,false] }],
                ['bold','italic','underline','strike'],
                [{ list:'ordered' },{ list:'bullet' }],
                ['link','image','blockquote','code-block'],
                [{ color:[] },{ background:[] }],
                ['clean']
            ]
        }
    });

    <% if (isEdit && item.konten) { %>
    quill.root.innerHTML = <%- JSON.stringify(item.konten) %>;
    <% } %>

    // (Submit handler dipindah ke bawah, setelah event crop)

    var slugEdited = <%= isEdit ? 'true' : 'false' %>;
    document.getElementById('judulInput').addEventListener('input', function() {
        if (!slugEdited) {
            document.getElementById('slugInput').value = this.value
                .toLowerCase().replace(/[^a-z0-9\s-]/g,'').trim().replace(/\s+/g,'-');
        }
    });
    document.getElementById('slugInput').addEventListener('input', function() { slugEdited = true; });

    // ─── Crop: Berita (16:9) ─────────────────────────────────────
    var _beritaOrigSrc = null;

    function applyCropResult(dataURL) {
        document.getElementById('gambarCropInput').value = dataURL;
        document.getElementById('imgPreview').src = dataURL;
        document.getElementById('previewBox').classList.remove('hidden');
        var badge = document.getElementById('cropRequiredBadge');
        if (badge) badge.style.display = 'none';
        document.getElementById('uploadAreaLabel').style.display = 'none';
        _beritaOrigSrc = dataURL;
    }

    document.getElementById('gambarInput').addEventListener('change', function() {
        var file = this.files[0];
        if (!file) return;
        var reader = new FileReader();
        reader.onload = function(e) {
            _beritaOrigSrc = e.target.result;
            window._openCropModal(e.target.result, 16/9, applyCropResult);
        };
        reader.readAsDataURL(file);
        this.value = ''; // reset agar bisa pilih file yang sama lagi
    });

    // Tombol crop ulang
    var reopenBtn = document.getElementById('cropReopenBtn');
    if (reopenBtn) {
        reopenBtn.addEventListener('click', function() {
            var src = _beritaOrigSrc || document.getElementById('imgPreview').src;
            if (src) window._openCropModal(src, 16/9, applyCropResult);
        });
    }

    // Validasi wajib crop sebelum submit
    document.getElementById('beritaForm').addEventListener('submit', function(e) {
        document.getElementById('kontenInput').value = quill.root.innerHTML;
        var cropVal = document.getElementById('gambarCropInput').value;
        var isEdit  = <%= isEdit ? 'true' : 'false' %>;
        if (!cropVal && !isEdit) {
            e.preventDefault();
            alert('⚠️ Wajib memilih dan crop gambar utama sebelum menyimpan berita.');
            return false;
        }
    }, true); // capture phase — runs before Quill's submit
</script>

<!-- Cropper.js CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
<%- include('partials/_crop-modal') %>
<%- include('partials/footer', { extraScript: '' }) %>
