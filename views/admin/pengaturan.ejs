<%- include('partials/header', { activePage: 'pengaturan', extraHead: '' }) %>

<style>
    /* Styling for the premium tabs */
    .tabs-nav {
        display: flex;
        gap: 8px;
        border-bottom: 2px solid #e2e8f0;
        margin-bottom: 24px;
        padding-bottom: 4px;
    }
    .tab-btn {
        padding: 10px 20px;
        border: none;
        background: none;
        font-weight: 600;
        font-size: 14px;
        color: #64748b;
        cursor: pointer;
        border-bottom: 2px solid transparent;
        margin-bottom: -6px;
        transition: all 0.2s ease;
    }
    .tab-btn:hover {
        color: var(--primary);
    }
    .tab-btn.active {
        color: var(--primary);
        border-bottom-color: var(--primary);
    }
    .hidden {
        display: none !important;
    }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Pengaturan Website</h1>
        <p class="page-sub">Kelola konten halaman beranda, tentang kami, informasi kontak, dan tampilan website.</p>
    </div>
</div>

<!-- Tab Navigation -->
<div class="tabs-nav">
    <button type="button" class="tab-btn active" data-tab="beranda">
        <i class="fas fa-home" style="margin-right: 6px;"></i> Beranda & Umum
    </button>
    <button type="button" class="tab-btn" data-tab="tentang">
        <i class="fas fa-info-circle" style="margin-right: 6px;"></i> Halaman Tentang Kami
    </button>
</div>

<form action="/admin/pengaturan" method="POST" enctype="multipart/form-data" id="settingsForm">
<div class="form-grid">

    <!-- ── KOLOM UTAMA (KIRI) ────────────────────────────────────────────────── -->
    <div class="form-main" style="display:flex;flex-direction:column;gap:1.5rem;">
        
        <!-- ── TAB CONTENT: BERANDA & UMUM ── -->
        <div class="tab-content-main" id="tab-main-beranda">
            <div style="display:flex;flex-direction:column;gap:1.5rem;">
                <!-- Beranda Hero -->
                <div class="section-card">
                    <h3 class="card-subtitle" style="margin-bottom:1.25rem;">
                        <i class="fas fa-home" style="color:#e5792a;margin-right:.5rem;"></i>Konten Hero Beranda
                    </h3>
                    <div class="form-group">
                        <label class="form-label">Badge / Label Kecil</label>
                        <input type="text" name="hero_badge" class="form-input" value="<%= settings.hero_badge %>">
                        <small style="color:#6b7280;">Contoh: "Media Informasi Resmi"</small>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Judul Baris 1 <span class="required">*</span></label>
                        <input type="text" name="hero_title_line1" class="form-input" value="<%= settings.hero_title_line1 %>" required>
                        <small style="color:#6b7280;">Teks hitam di atas. Contoh: "Generasi Muda"</small>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Judul Baris 2 (Gradient) <span class="required">*</span></label>
                        <input type="text" name="hero_title_line2" class="form-input" value="<%= settings.hero_title_line2 %>" required>
                        <small style="color:#6b7280;">Teks warna oranye-ungu. Contoh: "Indonesia Emas"</small>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Deskripsi Hero</label>
                        <textarea name="hero_description" class="form-input form-textarea" rows="3"><%= settings.hero_description %></textarea>
                    </div>
                </div>

                <!-- Statistik Beranda -->
                <div class="section-card">
                    <h3 class="card-subtitle" style="margin-bottom:1.25rem;">
                        <i class="fas fa-chart-bar" style="color:#e5792a;margin-right:.5rem;"></i>Statistik Beranda (3 Angka)
                    </h3>
                    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem;">
                        <div class="form-group">
                            <label class="form-label">Angka 1</label>
                            <input type="text" name="stat1_number" class="form-input" value="<%= settings.stat1_number %>">
                            <input type="text" name="stat1_label" class="form-input" style="margin-top:.5rem;" value="<%= settings.stat1_label %>" placeholder="Label...">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Angka 2</label>
                            <input type="text" name="stat2_number" class="form-input" value="<%= settings.stat2_number %>">
                            <input type="text" name="stat2_label" class="form-input" style="margin-top:.5rem;" value="<%= settings.stat2_label %>" placeholder="Label...">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Angka 3</label>
                            <input type="text" name="stat3_number" class="form-input" value="<%= settings.stat3_number %>">
                            <input type="text" name="stat3_label" class="form-input" style="margin-top:.5rem;" value="<%= settings.stat3_label %>" placeholder="Label...">
                        </div>
                    </div>
                </div>

                <!-- Teks Berjalan (Marquee) -->
                <div class="section-card">
                    <h3 class="card-subtitle" style="margin-bottom:1.25rem;">
                        <i class="fas fa-scroll" style="color:#e5792a;margin-right:.5rem;"></i>Teks Berjalan (Marquee)
                    </h3>
                    <div class="form-group">
                        <label class="form-label">Aktifkan Marquee</label>
                        <select name="marquee_enabled" class="form-input form-select">
                            <option value="1" <%= (settings.marquee_enabled!=='0') ? 'selected' : '' %>>Aktif</option>
                            <option value="0" <%= (settings.marquee_enabled==='0') ? 'selected' : '' %>>Nonaktif</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Teks Marquee</label>
                        <input type="text" name="marquee_text" class="form-input" value="<%= settings.marquee_text %>" placeholder="Selamat datang di website kami...">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Link (opsional)</label>
                        <input type="url" name="marquee_link" class="form-input" value="<%= settings.marquee_link %>" placeholder="https://...">
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem;">
                        <div class="form-group">
                            <label class="form-label">Warna Background</label>
                            <input type="color" name="marquee_bg" value="<%= settings.marquee_bg||'#e5792a' %>" style="width:100%;height:40px;border:none;border-radius:8px;cursor:pointer;padding:2px;">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Warna Teks</label>
                            <input type="color" name="marquee_text_color" value="<%= settings.marquee_text_color||'#ffffff' %>" style="width:100%;height:40px;border:none;border-radius:8px;cursor:pointer;padding:2px;">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Kecepatan (detik)</label>
                            <input type="number" name="marquee_speed" class="form-input" value="<%= settings.marquee_speed||'25' %>" min="5" max="120">
                        </div>
                    </div>
                </div>

                <!-- Footer -->
                <div class="section-card">
                    <h3 class="card-subtitle" style="margin-bottom:1.25rem;">
                        <i class="fas fa-layer-group" style="color:#e5792a;margin-right:.5rem;"></i>Footer
                    </h3>
                    <div class="form-group">
                        <label class="form-label">Deskripsi Footer</label>
                        <textarea name="footer_description" class="form-input form-textarea" rows="3"><%= settings.footer_description %></textarea>
                    </div>
                </div>
                <!-- Google Search Console & SEO -->
                <div class="section-card">
                    <h3 class="card-subtitle" style="margin-bottom:1.25rem;">
                        <i class="fab fa-google" style="color:#e5792a;margin-right:.5rem;"></i>SEO & Google Search Console
                    </h3>
                    <div class="form-group">
                        <label class="form-label">Google Site Verification Code</label>
                        <input type="text" name="google_verification" class="form-input" value="<%= settings.google_verification || '' %>" placeholder="contoh: google1234567890abcdef">
                        <small style="color:#6b7280;">Masukkan kode verifikasi HTML tag Google Search Console Anda agar Google dapat mengindeks website ini.</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── TAB CONTENT: HALAMAN TENTANG KAMI ── -->
        <div class="tab-content-main hidden" id="tab-main-tentang">
            <div style="display:flex;flex-direction:column;gap:1.5rem;">
                <!-- Tentang Kami Hero -->
                <div class="section-card">
                    <h3 class="card-subtitle" style="margin-bottom:1.25rem;">
                        <i class="fas fa-info-circle" style="color:#e5792a;margin-right:.5rem;"></i>Konten Hero Tentang Kami
                    </h3>
                    <div class="form-group">
                        <label class="form-label">Badge / Label Kecil</label>
                        <input type="text" name="about_badge" class="form-input" value="<%= settings.about_badge %>">
                        <small style="color:#6b7280;">Contoh: "Tentang Kami"</small>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Judul Utama Halaman <span class="required">*</span></label>
                        <input type="text" name="about_title" class="form-input" value="<%= settings.about_title %>" required>
                        <small style="color:#6b7280;">Contoh: "Membangun Negeri Bersama Pemuda Indonesia"</small>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Paragraf Deskripsi 1 <span class="required">*</span></label>
                        <textarea name="about_description1" class="form-input form-textarea" rows="3" required><%= settings.about_description1 %></textarea>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Paragraf Deskripsi 2 <small>(opsional)</small></label>
                        <textarea name="about_description2" class="form-input form-textarea" rows="3"><%= settings.about_description2 %></textarea>
                    </div>
                </div>

                <!-- Visi & Misi -->
                <div class="section-card">
                    <h3 class="card-subtitle" style="margin-bottom:1.25rem;">
                        <i class="fas fa-bullseye" style="color:#e5792a;margin-right:.5rem;"></i>Visi & Misi Organisasi
                    </h3>
                    <div class="form-group">
                        <label class="form-label">Pernyataan Visi <span class="required">*</span></label>
                        <textarea name="about_visi" class="form-input form-textarea" rows="2" required><%= settings.about_visi %></textarea>
                    </div>
                    
                    <div style="display:flex;flex-direction:column;gap:0.75rem;margin-top:1rem;">
                        <label class="form-label">Poin-Poin Misi</label>
                        <div class="form-group">
                            <input type="text" name="about_misi1" class="form-input" value="<%= settings.about_misi1 %>" placeholder="Misi 1...">
                        </div>
                        <div class="form-group">
                            <input type="text" name="about_misi2" class="form-input" value="<%= settings.about_misi2 %>" placeholder="Misi 2...">
                        </div>
                        <div class="form-group">
                            <input type="text" name="about_misi3" class="form-input" value="<%= settings.about_misi3 %>" placeholder="Misi 3...">
                        </div>
                        <div class="form-group">
                            <input type="text" name="about_misi4" class="form-input" value="<%= settings.about_misi4 %>" placeholder="Misi 4...">
                        </div>
                    </div>
                </div>

                <!-- Program Unggulan -->
                <div class="section-card">
                    <h3 class="card-subtitle" style="margin-bottom:1.25rem;">
                        <i class="fas fa-lightbulb" style="color:#e5792a;margin-right:.5rem;"></i>4 Program Unggulan
                    </h3>
                    
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;">
                        <!-- Program 1 -->
                        <div style="padding:12px;border:1px solid #e2e8f0;border-radius:8px;">
                            <strong style="font-size:12px;color:var(--primary);display:block;margin-bottom:8px;">Program 1 (Icon Hati)</strong>
                            <div class="form-group">
                                <input type="text" name="about_program1_title" class="form-input" value="<%= settings.about_program1_title %>" placeholder="Judul Program 1">
                            </div>
                            <div class="form-group" style="margin-top:4px;">
                                <input type="text" name="about_program1_desc" class="form-input" value="<%= settings.about_program1_desc %>" placeholder="Deskripsi Singkat">
                            </div>
                        </div>

                        <!-- Program 2 -->
                        <div style="padding:12px;border:1px solid #e2e8f0;border-radius:8px;">
                            <strong style="font-size:12px;color:var(--primary);display:block;margin-bottom:8px;">Program 2 (Icon Bohlam)</strong>
                            <div class="form-group">
                                <input type="text" name="about_program2_title" class="form-input" value="<%= settings.about_program2_title %>" placeholder="Judul Program 2">
                            </div>
                            <div class="form-group" style="margin-top:4px;">
                                <input type="text" name="about_program2_desc" class="form-input" value="<%= settings.about_program2_desc %>" placeholder="Deskripsi Singkat">
                            </div>
                        </div>

                        <!-- Program 3 -->
                        <div style="padding:12px;border:1px solid #e2e8f0;border-radius:8px;">
                            <strong style="font-size:12px;color:var(--primary);display:block;margin-bottom:8px;">Program 3 (Icon Pohon)</strong>
                            <div class="form-group">
                                <input type="text" name="about_program3_title" class="form-input" value="<%= settings.about_program3_title %>" placeholder="Judul Program 3">
                            </div>
                            <div class="form-group" style="margin-top:4px;">
                                <input type="text" name="about_program3_desc" class="form-input" value="<%= settings.about_program3_desc %>" placeholder="Deskripsi Singkat">
                            </div>
                        </div>

                        <!-- Program 4 -->
                        <div style="padding:12px;border:1px solid #e2e8f0;border-radius:8px;">
                            <strong style="font-size:12px;color:var(--primary);display:block;margin-bottom:8px;">Program 4 (Icon Toga)</strong>
                            <div class="form-group">
                                <input type="text" name="about_program4_title" class="form-input" value="<%= settings.about_program4_title %>" placeholder="Judul Program 4">
                            </div>
                            <div class="form-group" style="margin-top:4px;">
                                <input type="text" name="about_program4_desc" class="form-input" value="<%= settings.about_program4_desc %>" placeholder="Deskripsi Singkat">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ── KOLOM SIDEBAR (KANAN) ─────────────────────────────────────────────── -->
    <div class="form-sidebar" style="display:flex;flex-direction:column;gap:1.5rem;">

        <!-- ── TAB CONTENT SIDEBAR: BERANDA ── -->
        <div class="tab-content-sidebar" id="tab-sidebar-beranda">
            <div style="display:flex;flex-direction:column;gap:1.5rem;">
                <!-- Foto Hero -->
                <div class="section-card">
                    <h3 class="card-subtitle" style="margin-bottom:1.25rem;">
                        <i class="fas fa-image" style="color:#e5792a;margin-right:.5rem;"></i>Foto Hero Beranda
                    </h3>
                    <div id="heroPreviewBox" style="margin-bottom:1rem;">
                        <img id="heroImgPreview" src="<%= settings.hero_image %>" alt="Hero" style="width:100%;border-radius:12px;object-fit:cover;max-height:200px;">
                    </div>
                    <label class="upload-area" for="heroImgInput">
                        <i class="fas fa-cloud-upload-alt"></i>
                        <span>Klik untuk ganti foto hero</span>
                        <small>JPG, PNG, WebP — Maks. 5MB</small>
                        <input type="file" name="hero_image_file" id="heroImgInput" accept="image/*" style="display:none">
                    </label>
                    <div class="form-group" style="margin-top:1rem;">
                        <label class="form-label">Atau masukkan URL gambar</label>
                        <input type="url" name="hero_image" id="heroUrlInput" class="form-input" value="<%= settings.hero_image %>" placeholder="https://...">
                    </div>
                </div>

                <!-- Warna Tema -->
                <div class="section-card">
                    <h3 class="card-subtitle" style="margin-bottom:1.25rem;">
                        <i class="fas fa-palette" style="color:#e5792a;margin-right:.5rem;"></i>Warna Tema
                    </h3>
                    <div class="form-group">
                        <label class="form-label">Warna Utama (Tombol, Badge, Link)</label>
                        <div style="display:flex;align-items:center;gap:.75rem;">
                            <input type="color" name="primary_color" id="primaryColorPicker" value="<%= settings.primary_color||'#e5792a' %>" style="width:48px;height:40px;border:none;border-radius:8px;cursor:pointer;padding:2px;">
                            <input type="text" id="primaryColorHex" class="form-input" value="<%= settings.primary_color||'#e5792a' %>" placeholder="#e5792a" style="font-family:monospace;max-width:120px;">
                        </div>
                    </div>
                    <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.5rem;">
                        <% [['#e5792a','Oranye'],['#16a34a','Hijau'],['#2563eb','Biru'],['#dc2626','Merah'],['#7c3aed','Ungu'],['#0891b2','Cyan'],['#d97706','Amber'],['#be185d','Pink']].forEach(function(c) { %>
                        <button type="button" onclick="setPrimaryColor('<%= c[0] %>')" title="<%= c[1] %>" style="width:28px;height:28px;border-radius:6px;background:<%= c[0] %>;border:2px solid #fff;box-shadow:0 0 0 1px #ddd;cursor:pointer;"></button>
                        <% }); %>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── TAB CONTENT SIDEBAR: TENTANG ── -->
        <div class="tab-content-sidebar hidden" id="tab-sidebar-tentang">
            <div style="display:flex;flex-direction:column;gap:1.5rem;">
                <!-- Foto Tentang -->
                <div class="section-card">
                    <h3 class="card-subtitle" style="margin-bottom:1.25rem;">
                        <i class="fas fa-image" style="color:#e5792a;margin-right:.5rem;"></i>Foto Halaman Tentang
                    </h3>
                    <div id="aboutPreviewBox" style="margin-bottom:1rem;">
                        <img id="aboutImgPreview" src="<%= settings.about_image %>" alt="Tentang" style="width:100%;border-radius:12px;object-fit:cover;max-height:200px;">
                    </div>
                    <label class="upload-area" for="aboutImgInput">
                        <i class="fas fa-cloud-upload-alt"></i>
                        <span>Klik untuk ganti foto tentang</span>
                        <small>JPG, PNG, WebP — Maks. 5MB</small>
                        <input type="file" name="about_image_file" id="aboutImgInput" accept="image/*" style="display:none">
                    </label>
                    <div class="form-group" style="margin-top:1rem;">
                        <label class="form-label">Atau masukkan URL gambar</label>
                        <input type="url" name="about_image" id="aboutUrlInput" class="form-input" value="<%= settings.about_image %>" placeholder="https://...">
                    </div>
                </div>

                <!-- Statistik Tentang (Tahun Mengabdi) -->
                <div class="section-card">
                    <h3 class="card-subtitle" style="margin-bottom:1.25rem;">
                        <i class="fas fa-hourglass-half" style="color:#e5792a;margin-right:.5rem;"></i>Lama Mengabdi
                    </h3>
                    <div class="form-group">
                        <label class="form-label">Jumlah Tahun Mengabdi</label>
                        <input type="number" name="about_years" class="form-input" value="<%= settings.about_years %>" min="1" max="200" required>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── GLOBAL SIDEBAR ITEMS (ALWAYS VISIBLE) ── -->
        <!-- Kontak -->
        <div class="section-card">
            <h3 class="card-subtitle" style="margin-bottom:1.25rem;">
                <i class="fas fa-address-card" style="color:#e5792a;margin-right:.5rem;"></i>Informasi Kontak
            </h3>
            <div class="form-group">
                <label class="form-label"><i class="fas fa-map-marker-alt" style="color:#e5792a;width:16px;"></i> Alamat</label>
                <textarea name="kontak_alamat" class="form-input form-textarea" rows="2"><%= settings.kontak_alamat %></textarea>
            </div>
            <div class="form-group">
                <label class="form-label"><i class="fas fa-phone" style="color:#e5792a;width:16px;"></i> No. Telepon</label>
                <input type="text" name="kontak_phone" class="form-input" value="<%= settings.kontak_phone %>" placeholder="+62 8xx-xxxx-xxxx">
            </div>
            <div class="form-group">
                <label class="form-label"><i class="fas fa-envelope" style="color:#e5792a;width:16px;"></i> Email</label>
                <input type="email" name="kontak_email" class="form-input" value="<%= settings.kontak_email %>">
            </div>
            <div class="form-group">
                <label class="form-label"><i class="fab fa-whatsapp" style="color:#25d366;width:16px;"></i> WhatsApp</label>
                <input type="text" name="kontak_whatsapp" class="form-input" value="<%= settings.kontak_whatsapp %>" placeholder="+62 8xx-xxxx-xxxx">
            </div>
        </div>

        <!-- Sosial Media -->
        <div class="section-card">
            <h3 class="card-subtitle" style="margin-bottom:1.25rem;">
                <i class="fas fa-share-alt" style="color:#e5792a;margin-right:.5rem;"></i>Media Sosial
            </h3>
            <div class="form-group">
                <label class="form-label"><i class="fab fa-instagram" style="color:#e1306c;width:16px;"></i> Instagram</label>
                <input type="url" name="kontak_instagram" class="form-input" value="<%= settings.kontak_instagram %>" placeholder="https://instagram.com/...">
            </div>
            <div class="form-group">
                <label class="form-label"><i class="fab fa-tiktok" style="color:#000;width:16px;"></i> TikTok</label>
                <input type="url" name="kontak_tiktok" class="form-input" value="<%= settings.kontak_tiktok %>" placeholder="https://tiktok.com/@...">
            </div>
            <div class="form-group">
                <label class="form-label"><i class="fab fa-facebook" style="color:#1877f2;width:16px;"></i> Facebook</label>
                <input type="url" name="kontak_facebook" class="form-input" value="<%= settings.kontak_facebook %>" placeholder="https://facebook.com/...">
            </div>
        </div>

        <!-- Save Button -->
        <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-full">
                <i class="fas fa-save"></i> Simpan Pengaturan
            </button>
        </div>

    </div>
</div>
</form>

<script>
// Tab Navigation logic
document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        // Remove active class from all buttons
        document.querySelectorAll('.tab-btn').forEach(b => {
            b.classList.remove('active');
        });
        
        // Add active class to clicked button
        this.classList.add('active');
        
        const tab = this.getAttribute('data-tab');
        
        // Toggle main content tabs
        document.querySelectorAll('.tab-content-main').forEach(tc => {
            tc.classList.add('hidden');
        });
        document.getElementById('tab-main-' + tab).classList.remove('hidden');
        
        // Toggle sidebar tabs
        document.querySelectorAll('.tab-content-sidebar').forEach(tc => {
            tc.classList.add('hidden');
        });
        document.getElementById('tab-sidebar-' + tab).classList.remove('hidden');
    });
});

// Live previews for images
document.getElementById('heroImgInput').addEventListener('change', function() {
    var file = this.files[0];
    if (file) {
        var reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById('heroImgPreview').src = e.target.result;
            document.getElementById('heroUrlInput').value = '';
        };
        reader.readAsDataURL(file);
    }
});

document.getElementById('aboutImgInput').addEventListener('change', function() {
    var file = this.files[0];
    if (file) {
        var reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById('aboutImgPreview').src = e.target.result;
            document.getElementById('aboutUrlInput').value = '';
        };
        reader.readAsDataURL(file);
    }
});

// Color picker hex synchronization
var pc = document.getElementById('primaryColorPicker');
var ph = document.getElementById('primaryColorHex');
if (pc && ph) {
    pc.addEventListener('input', function() { ph.value = this.value; });
    ph.addEventListener('input', function() {
        var v = this.value;
        if (/^#[0-9a-fA-F]{6}$/.test(v)) pc.value = v;
    });
}
function setPrimaryColor(hex) {
    if (pc) pc.value = hex;
    if (ph) ph.value = hex;
}
</script>

