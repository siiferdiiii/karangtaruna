<% var isEdit = item !== null; %>
<%- include('partials/header', { activePage: 'kegiatan', extraHead: '<link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet"><link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" rel="stylesheet">' }) %>

<div class="page-header">
    <div>
        <h1 class="page-title"><%= isEdit ? 'Edit Kegiatan' : 'Tambah Kegiatan Baru' %></h1>
        <p class="page-sub"><% if (isEdit) { %>Mengedit: <strong><%= item.judul %></strong><% } else { %>Isi form di bawah untuk menambah kegiatan baru<% } %></p>
    </div>
    <a href="/admin/kegiatan" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Kembali</a>
</div>

<form action="/admin/kegiatan/<%= isEdit ? 'edit/' + item.id : 'tambah' %>" method="POST" enctype="multipart/form-data" class="form-page" id="kegiatanForm">
    <div class="form-grid">
        <!-- Kolom Kiri -->
        <div class="form-main">
            <div class="section-card">
                <div class="form-group">
                    <label class="form-label">Judul Kegiatan <span class="required">*</span></label>
                    <input type="text" name="judul" class="form-input" value="<%= isEdit ? item.judul : '' %>" placeholder="Nama kegiatan..." required>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Kategori <span class="required">*</span></label>
                        <select name="kategori" class="form-input form-select" required>
                            <% ['sosial','lingkungan','edukasi','kreativitas'].forEach(function(kat) { %>
                            <option value="<%= kat %>" <%= isEdit && item.kategori === kat ? 'selected' : '' %>><%= kat.charAt(0).toUpperCase() + kat.slice(1) %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Lokasi <span class="required">*</span></label>
                        <input type="text" name="lokasi" class="form-input" value="<%= isEdit ? item.lokasi : '' %>" placeholder="Balai Kelurahan, dll." required>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Tanggal Kegiatan Dimulai <span class="required">*</span></label>
                    <% 
                        var dateVal = '';
                        if (isEdit && item.tanggal) {
                            dateVal = new Date(item.tanggal).toISOString().split('T')[0];
                        }
                    %>
                    <input type="date" name="tanggal" class="form-input" value="<%= dateVal %>" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Deskripsi Kegiatan <span class="required">*</span></label>
                    <div id="quill-editor" style="min-height:260px;"></div>
                    <input type="hidden" name="deskripsi" id="deskripsiInput">
                </div>
            </div>

            <!-- Pendaftaran Online -->
            <div class="section-card">
                <h3 class="card-subtitle"><i class="fas fa-clipboard-list"></i> Pendaftaran Online</h3>
                <div class="toggle-group">
                    <label class="toggle-switch">
                        <input type="checkbox" name="buka_pendaftaran" id="bukaPendaftaran" <%= isEdit && item.buka_pendaftaran ? 'checked' : '' %>>
                        <span class="toggle-slider"></span>
                    </label>
                    <div>
                        <strong>Aktifkan Formulir Pendaftaran</strong>
                        <p class="help-text">Jika diaktifkan, warga bisa mendaftar kegiatan ini secara online melalui halaman website publik.</p>
                    </div>
                </div>
                <div id="pendaftaranInfo" style="display:<%= isEdit && item.buka_pendaftaran ? 'block' : 'none' %>; margin-top:1rem;">
                    <div class="form-row" style="margin-bottom:1rem;">
                        <div class="form-group">
                            <label class="form-label">Tanggal Pendaftaran Dibuka</label>
                            <% 
                                var tglBuka = '';
                                if (isEdit && item.pendaftaran_dibuka) {
                                    tglBuka = new Date(item.pendaftaran_dibuka).toISOString().split('T')[0];
                                }
                            %>
                            <input type="date" name="pendaftaran_dibuka" class="form-input" value="<%= tglBuka %>">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Tanggal Pendaftaran Ditutup</label>
                            <% 
                                var tglTutup = '';
                                if (isEdit && item.pendaftaran_ditutup) {
                                    tglTutup = new Date(item.pendaftaran_ditutup).toISOString().split('T')[0];
                                }
                            %>
                            <input type="date" name="pendaftaran_ditutup" class="form-input" value="<%= tglTutup %>">
                        </div>
                    </div>
                    <div class="info-box">
                        <i class="fas fa-info-circle"></i>
                        Form pendaftaran akan tersedia di halaman publik kegiatan ini.<br>
                        Data pendaftaran bisa dilihat di menu <a href="/admin/formulir">Data Pendaftaran</a>.
                    </div>
                </div>
            </div>
        </div>

        <!-- Kolom Kanan -->
        <div class="form-sidebar">
            <div class="section-card">
                <h3 class="card-subtitle">Gambar Kegiatan</h3>

                <!-- Hidden input penampung hasil crop (base64) -->
                <input type="hidden" name="gambar_crop" id="gambarCropInput">

                <!-- Badge wajib crop -->
                <% if (!isEdit || !item.gambar) { %>
                <div id="cropRequiredBadge" class="crop-required-badge">
                    <i class="fas fa-crop-alt"></i> Wajib pilih &amp; crop gambar sebelum menyimpan
                </div>
                <% } %>

                <!-- Preview hasil crop -->
                <div id="previewBox" class="<%= (isEdit && item.gambar) ? '' : 'hidden' %>">
                    <img id="imgPreview" src="<%= (isEdit && item.gambar) ? item.gambar : '' %>" alt="Preview" class="img-preview">
                    <button type="button" class="crop-reopen-btn" id="cropReopenBtn">
                        <i class="fas fa-crop-alt"></i> Crop Ulang
                    </button>
                </div>

                <!-- Upload area -->
                <label class="upload-area" for="gambarInput" id="uploadAreaLabel">
                    <i class="fas fa-cloud-upload-alt"></i>
                    <span>Klik atau drag gambar ke sini</span>
                    <small>JPG, PNG, WebP — Maks. 5MB &bull; Rasio 4:3</small>
                    <input type="file" id="gambarInput" accept="image/*" style="display:none">
                </label>

                <style>
                .crop-required-badge {
                    background: rgba(234,179,8,0.12);
                    border: 1px solid rgba(234,179,8,0.3);
                    color: #fbbf24;
                    border-radius: 8px;
                    padding: 0.5rem 0.75rem;
                    font-size: 0.78rem;
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                    margin-bottom: 0.75rem;
                }
                .img-preview { width:100%; border-radius:8px; display:block; }
                #previewBox { position:relative; margin-bottom:0.75rem; }
                .crop-reopen-btn {
                    position: absolute;
                    bottom: 8px; right: 8px;
                    background: rgba(0,0,0,0.65);
                    color: #fff;
                    border: none;
                    border-radius: 6px;
                    padding: 0.35rem 0.75rem;
                    font-size: 0.75rem;
                    cursor: pointer;
                    display: flex;
                    align-items: center;
                    gap: 0.4rem;
                    transition: background 0.2s;
                }
                .crop-reopen-btn:hover { background: rgba(99,102,241,0.8); }
                </style>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-full">
                    <i class="fas fa-save"></i> <%= isEdit ? 'Simpan Perubahan' : 'Simpan Kegiatan' %>
                </button>
                <a href="/admin/kegiatan" class="btn btn-ghost btn-full">Batal</a>
            </div>
        </div>
    </div>
</form>

<!-- Quill Editor -->
<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<script>
    var quill = new Quill('#quill-editor', {
        theme: 'snow',
        placeholder: 'Deskripsi lengkap kegiatan...',
        modules: {
            toolbar: [
                [{ header: [1,2,3,false] }],
                ['bold','italic','underline'],
                [{ list:'ordered' },{ list:'bullet' }],
                ['link','blockquote'],
                ['clean']
            ]
        }
    });

    <% if (isEdit && item.deskripsi) { %>
    quill.root.innerHTML = <%- JSON.stringify(item.deskripsi) %>;
    <% } %>

    // (Submit handler dipindah ke bawah, setelah event crop)

    // ─── Crop: Kegiatan (4:3) ─────────────────────────────────
    var _kegiatanOrigSrc = null;

    function applyCropResult(dataURL) {
        document.getElementById('gambarCropInput').value = dataURL;
        document.getElementById('imgPreview').src = dataURL;
        document.getElementById('previewBox').classList.remove('hidden');
        var badge = document.getElementById('cropRequiredBadge');
        if (badge) badge.style.display = 'none';
        document.getElementById('uploadAreaLabel').style.display = 'none';
        _kegiatanOrigSrc = dataURL;
    }

    document.getElementById('gambarInput').addEventListener('change', function() {
        var file = this.files[0];
        if (!file) return;
        var reader = new FileReader();
        reader.onload = function(e) {
            _kegiatanOrigSrc = e.target.result;
            window._openCropModal(e.target.result, 4/3, applyCropResult);
        };
        reader.readAsDataURL(file);
        this.value = '';
    });

    // Tombol crop ulang
    var reopenBtn = document.getElementById('cropReopenBtn');
    if (reopenBtn) {
        reopenBtn.addEventListener('click', function() {
            var src = _kegiatanOrigSrc || document.getElementById('imgPreview').src;
            if (src) window._openCropModal(src, 4/3, applyCropResult);
        });
    }

    // Validasi wajib crop sebelum submit
    document.getElementById('kegiatanForm').addEventListener('submit', function(e) {
        document.getElementById('deskripsiInput').value = quill.root.innerHTML;
        var cropVal = document.getElementById('gambarCropInput').value;
        var isEdit  = <%= isEdit ? 'true' : 'false' %>;
        if (!cropVal && !isEdit) {
            e.preventDefault();
            alert('⚠️ Wajib memilih dan crop gambar sebelum menyimpan kegiatan.');
            return false;
        }
    }, true);

    document.getElementById('bukaPendaftaran').addEventListener('change', function() {
        document.getElementById('pendaftaranInfo').style.display = this.checked ? 'block' : 'none';
    });
</script>

<!-- Cropper.js CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
<%- include('partials/_crop-modal') %>
<%- include('partials/footer', { extraScript: '' }) %>
